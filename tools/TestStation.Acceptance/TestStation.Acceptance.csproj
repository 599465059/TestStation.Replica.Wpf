<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/TestStation.App/TestStation.App.csproj" />
    <!-- The acceptance harness constructs MainViewModel directly. Keep the
         simulated family assembly in its runtime dependency graph instead of
         relying on App's transitive reference when launched standalone. -->
    <ProjectReference Include="../../src/TestStation.SimulatedPlugins/TestStation.SimulatedPlugins.csproj" />
  </ItemGroup>
</Project>
