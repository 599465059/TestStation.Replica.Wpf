<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Neutral gray foundation. Accent colors are reserved for focus and
         selection; surfaces stay gray even when the accent palette changes. -->
    <SolidColorBrush x:Key="WindowBrush" Color="#30353A"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#3A4147"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#444B52"/>
    <SolidColorBrush x:Key="ContentBrush" Color="#353C42"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#485159"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#4A5259"/>
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#5DA9FF"/>
    <Color x:Key="SelectedRowColor">#5DA9FF</Color>
    <Color x:Key="SelectionTextColor">#202020</Color>
    <SolidColorBrush x:Key="TextBrush" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#B8B8B8"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#555555"/>
    <SolidColorBrush x:Key="CanvasMajorGridBrush" Color="#66727F"/>
    <SolidColorBrush x:Key="CanvasGridTickBrush" Color="#586571"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#5DA9FF"/>
    <!-- Built-in step colors remain semantic and independent of the accent. -->
    <SolidColorBrush x:Key="FlowStepBrush" Color="#64B5F6"/>
    <SolidColorBrush x:Key="ActionStepBrush" Color="#66D9A3"/>
    <SolidColorBrush x:Key="TimingStepBrush" Color="#F6C56B"/>
    <SolidColorBrush x:Key="ComparisonStepBrush" Color="#FF8A8A"/>
    <SolidColorBrush x:Key="SequenceStepBrush" Color="#7DD3FC"/>
    <SolidColorBrush x:Key="UtilityStepBrush" Color="#C4B5FD"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF7A7A"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F6B756"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#52C878"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#5DA9FF"/>

    <!-- Shared aliases used by the editor templates and HandyControl overrides. -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F5F7"/>
    <SolidColorBrush x:Key="StrongTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#D7DEE7"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#AAB3BF"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#6F7884"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#394147"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#65717B"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#4B555D"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#76B8FF"/>
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#3A4147"/>
    <SolidColorBrush x:Key="DataGridAltRowBrush" Color="#3D454C"/>
    <SolidColorBrush x:Key="BlueSwatchBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="PurpleSwatchBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="TealSwatchBrush" Color="#0F766E"/>
    <!-- Semantic protocol colors remain visible on the gray dark surface. -->
    <SolidColorBrush x:Key="ProtocolHeaderBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="ProtocolIdBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="ProtocolLengthBrush" Color="#A78BFA"/>
    <SolidColorBrush x:Key="ProtocolDataBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="ProtocolChecksumBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="ProtocolTailBrush" Color="#22D3EE"/>
    <SolidColorBrush x:Key="ProtocolSkipBrush" Color="#9CA3AF"/>
</ResourceDictionary>
