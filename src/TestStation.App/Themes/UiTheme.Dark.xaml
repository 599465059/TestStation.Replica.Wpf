<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Cool neutral foundation with distinct elevation levels:
         Window (darkest) < Content < Surface < Subtle. Accent colors are reserved
         for focus and selection; surfaces stay neutral when the accent changes. -->
    <SolidColorBrush x:Key="WindowBrush" Color="#1F2328"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2B3138"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#323942"/>
    <SolidColorBrush x:Key="ContentBrush" Color="#252A30"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#3A424C"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#26384F"/>
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#324862"/>
    <Color x:Key="SelectedRowColor">#324862</Color>
    <Color x:Key="SelectionTextColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="TextBrush" Color="#E6E9ED"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8D97A5"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3B434D"/>
    <SolidColorBrush x:Key="CanvasMajorGridBrush" Color="#4A5562"/>
    <SolidColorBrush x:Key="CanvasGridTickBrush" Color="#3F4954"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#5DA9FF"/>
    <!-- Built-in step colors remain semantic and independent of the accent. -->
    <SolidColorBrush x:Key="FlowStepBrush" Color="#64B5F6"/>
    <SolidColorBrush x:Key="ActionStepBrush" Color="#66D9A3"/>
    <SolidColorBrush x:Key="TimingStepBrush" Color="#F6C56B"/>
    <SolidColorBrush x:Key="ComparisonStepBrush" Color="#FF8A8A"/>
    <SolidColorBrush x:Key="SequenceStepBrush" Color="#7DD3FC"/>
    <SolidColorBrush x:Key="UtilityStepBrush" Color="#C4B5FD"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF7A7A"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F6B756"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#52C878"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#5DA9FF"/>

    <!-- Shared aliases used by the editor templates and HandyControl overrides. -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E6E9ED"/>
    <SolidColorBrush x:Key="StrongTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C9D0D8"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#8D97A5"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#5C6672"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#22272D"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#4A535E"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#343C46"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#76B8FF"/>
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#2B3138"/>
    <SolidColorBrush x:Key="DataGridAltRowBrush" Color="#282D34"/>
    <!-- Row separators are quieter than panel borders. -->
    <SolidColorBrush x:Key="GridLineBrush" Color="#2F363E"/>
    <!-- Sequence role and variable scope markers (SequenceWorkspace). -->
    <SolidColorBrush x:Key="MainSequenceBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="SubSequenceBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="LocalScopeBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="GlobalScopeBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="StationScopeBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="ParameterScopeBrush" Color="#C084FC"/>
    <!-- Card surface: one step brighter than the window in light mode, raised in dark mode. -->
    <SolidColorBrush x:Key="CardBrush" Color="#2B3138"/>
    <!-- Energized output (power supply / load output on). The only persistent orange in the shell. -->
    <SolidColorBrush x:Key="LiveBrush" Color="#F6B756"/>
    <SolidColorBrush x:Key="LiveSurfaceBrush" Color="#3A3326"/>
    <SolidColorBrush x:Key="LiveTextBrush" Color="#FFD592"/>
    <!-- Device connection dots. -->
    <SolidColorBrush x:Key="StatusOnlineBrush" Color="#52C878"/>
    <SolidColorBrush x:Key="StatusIdleBrush" Color="#8D97A5"/>
    <SolidColorBrush x:Key="StatusFaultBrush" Color="#FF7A7A"/>
    <SolidColorBrush x:Key="BlueSwatchBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="PurpleSwatchBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="TealSwatchBrush" Color="#0F766E"/>
    <SolidColorBrush x:Key="OrangeSwatchBrush" Color="#C2410C"/>
    <!-- Semantic protocol colors remain visible on the gray dark surface. -->
    <SolidColorBrush x:Key="ProtocolHeaderBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="ProtocolIdBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="ProtocolLengthBrush" Color="#A78BFA"/>
    <SolidColorBrush x:Key="ProtocolDataBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="ProtocolChecksumBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="ProtocolTailBrush" Color="#22D3EE"/>
    <SolidColorBrush x:Key="ProtocolSkipBrush" Color="#9CA3AF"/>
</ResourceDictionary>
