<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:converters="clr-namespace:TestStation.App.Converters">
    <!-- Adapted from the authorized reference editor; uses this project's palette. -->
    <converters:SequenceRowTemplateSelector x:Key="StepRowTemplateSelector"/>
    <Style x:Key="StepPaletteItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
        <Setter Property="IsExpanded" Value="True"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style x:Key="StepIconStyle" TargetType="md:PackIcon">
        <Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Foreground" Value="{DynamicResource ActionStepBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Category}" Value="flow"><Setter Property="Foreground" Value="{DynamicResource FlowStepBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="timing"><Setter Property="Foreground" Value="{DynamicResource TimingStepBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="comparison"><Setter Property="Foreground" Value="{DynamicResource ComparisonStepBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="sequence"><Setter Property="Foreground" Value="{DynamicResource SequenceStepBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="utility"><Setter Property="Foreground" Value="{DynamicResource UtilityStepBrush}"/></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SequenceRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Background" Value="{DynamicResource ContentBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
            <DataTrigger Binding="{Binding RowType}" Value="group">
                <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
                <Setter Property="Height" Value="30"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></DataTrigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectedRowBrush}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StepEnabledStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers><DataTrigger Binding="{Binding RowType}" Value="step"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
    </Style>
    <!-- Run status colors come from semantic theme brushes; not-run rows stay muted. -->
    <Style x:Key="StepStatusTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusKind}" Value="success"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
            <DataTrigger Binding="{Binding StatusKind}" Value="error"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
            <DataTrigger Binding="{Binding StatusKind}" Value="running"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="StepNameTemplate">
        <StackPanel Orientation="Horizontal" Margin="{Binding Depth, Converter={StaticResource IndentToMargin}}" VerticalAlignment="Center">
            <md:PackIcon Kind="{Binding Step.Kind, Converter={StaticResource StepKindToIcon}}" Style="{StaticResource StepIconStyle}"/>
            <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Step.Description}"/>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="GroupHeaderTemplate">
        <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
            <md:PackIcon Width="14" Height="14" Margin="0,0,6,0" Foreground="{DynamicResource MutedBrush}">
                <md:PackIcon.Style><Style TargetType="md:PackIcon">
                    <Setter Property="Kind" Value="ChevronDown"/>
                    <Style.Triggers><DataTrigger Binding="{Binding IsCollapsed}" Value="True"><Setter Property="Kind" Value="ChevronRight"/></DataTrigger></Style.Triggers>
                </Style></md:PackIcon.Style>
            </md:PackIcon>
            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12"/>
            <TextBlock Text="{Binding GroupStepCount, StringFormat='  ({0})'}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="GroupFooterTemplate">
        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontStyle="Italic" Margin="8,0"/>
    </DataTemplate>
    <DataTemplate x:Key="BranchTemplate">
        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="{Binding Depth, Converter={StaticResource IndentToMargin}}"/>
    </DataTemplate>
</ResourceDictionary>
