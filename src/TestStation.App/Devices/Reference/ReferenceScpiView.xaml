<UserControl x:Class="TestStation.App.Devices.Reference.ReferenceScpiView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:TestStation.App.Localization"
 Style="{StaticResource DeviceOperationPanelStyle}" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}">
 <StackPanel x:Name="OperationPanel" Margin="8" MinWidth="360" MaxWidth="1050" VerticalAlignment="Top">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding SelectedDevice.Name, TargetNullValue={x:Static loc:UiText.RefDeviceInstance}}" Style="{StaticResource DevicePanelTitleStyle}" ToolTip="{Binding SelectedDevice.Name}" Margin="0,0,8,0"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button Content="{x:Static loc:UiText.RefConnect}" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnect}" Style="{DynamicResource AppToolBarButtonStyle}"/>
    <Button Content="{x:Static loc:UiText.RefDisconnect}" Command="{Binding DisconnectCommand}" IsEnabled="{Binding CanOperate}" Style="{DynamicResource AppToolBarButtonStyle}"/>
   </StackPanel>
  </Grid>
  <TextBlock Text="{Binding ConnectionText}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
  <Border Style="{StaticResource DevicePanelSectionStyle}">
   <StackPanel>
    <DockPanel Margin="0,0,0,6">
     <WrapPanel DockPanel.Dock="Right">
      <CheckBox Content="{x:Static loc:UiText.RefAutoRefresh}" IsChecked="{Binding AutoRefresh}" IsEnabled="{Binding CanSelectDevice}" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <Button Content="{x:Static loc:UiText.RefReadOnce}" Command="{Binding ReadOnceCommand}" IsEnabled="{Binding CanOperate}" Style="{DynamicResource AppToolBarButtonStyle}"/>
     </WrapPanel>
     <TextBlock Text="{x:Static loc:UiText.RefChannel}" FontWeight="SemiBold"/>
    </DockPanel>
    <Grid>
     <Grid Style="{StaticResource DevicePanelFamilyOnlyStyle}">
   <DataGrid x:Name="ChannelGrid" ItemsSource="{Binding Fields}" Style="{StaticResource AppDataGridStyle}"
    AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
    HeadersVisibility="Column" RowHeaderWidth="0" ColumnHeaderHeight="32" RowHeight="34" MinHeight="150" MaxHeight="380"
    CanUserResizeColumns="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
    <DataGrid.Columns>
     <DataGridTextColumn Header="{x:Static loc:UiText.RefChannel}" Binding="{Binding Name}" Width="*" MinWidth="180" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
     <DataGridTextColumn Header="{x:Static loc:UiText.RefDataType}" Binding="{Binding DataTypeDisplay}" Width="90" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
     <DataGridTextColumn Header="{x:Static loc:UiText.Unit}" Binding="{Binding Unit}" Width="65" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
     <DataGridTextColumn Header="{x:Static loc:UiText.Value}" Binding="{Binding Display}" Width="130" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
     <DataGridTemplateColumn Header="{x:Static loc:UiText.RefInput}" Width="140" MinWidth="110">
      <DataGridTemplateColumn.CellTemplate><DataTemplate>
       <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSetValue}" Margin="2">
        <TextBox.IsReadOnly><Binding Path="DataContext.IsBusy" RelativeSource="{RelativeSource AncestorType=UserControl}"/></TextBox.IsReadOnly>
       </TextBox>
      </DataTemplate></DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <DataGridTemplateColumn Header="{x:Static loc:UiText.RefOperations}" Width="150">
      <DataGridTemplateColumn.CellTemplate><DataTemplate>
       <StackPanel Orientation="Horizontal" IsEnabled="{Binding DataContext.CanOperate, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Button Content="{x:Static loc:UiText.RefRead}" Command="{Binding DataContext.ReadFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" IsEnabled="{Binding CanRead}" Style="{DynamicResource AppButtonStyle}" Margin="2"/>
        <Button Content="{Binding WriteCaption}" Command="{Binding DataContext.WriteFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" IsEnabled="{Binding CanWrite}" Style="{DynamicResource AppButtonStyle}" Margin="2"/>
       </StackPanel>
      </DataTemplate></DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <DataGridTextColumn Header="{x:Static loc:UiText.Status}" Binding="{Binding Quality}" Width="180" MinWidth="130" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
    </DataGrid.Columns>
   </DataGrid>
     </Grid>
     <Border Style="{StaticResource DevicePanelInstanceOnlyStyle}">
      <ListBox x:Name="CompactChannels" ItemsSource="{Binding Fields}" BorderThickness="0" Background="Transparent"
       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
       ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
       MinHeight="110" MaxHeight="330" HorizontalContentAlignment="Stretch">
       <ListBox.ItemTemplate><DataTemplate>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,5,0,6" HorizontalAlignment="Stretch">
         <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Definition.Id}" FontWeight="SemiBold" Margin="0,0,8,0"/>
           <StackPanel Grid.Column="1" Orientation="Horizontal">
            <TextBlock Text="{Binding Display}" FontFamily="{DynamicResource ReadoutFontFamily}"/>
            <TextBlock Text="{Binding Unit}" Foreground="{DynamicResource MutedBrush}" Margin="5,0,0,0"/>
           </StackPanel>
          </Grid>
          <Grid Grid.Row="1" Margin="0,5,0,0">
           <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSetValue}" ToolTip="{Binding DataTypeDisplay}"
            IsReadOnly="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
           <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0" IsEnabled="{Binding DataContext.CanOperate, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Button Content="{x:Static loc:UiText.RefRead}" Command="{Binding DataContext.ReadFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" IsEnabled="{Binding CanRead}" Style="{DynamicResource AppToolBarButtonStyle}"/>
            <Button Content="{Binding WriteCaption}" Command="{Binding DataContext.WriteFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" IsEnabled="{Binding CanWrite}" Style="{DynamicResource AppToolBarButtonStyle}"/>
           </StackPanel>
           <TextBlock Grid.Column="2" Text="{Binding Quality}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Quality}" VerticalAlignment="Center" Margin="6,0,0,0"/>
          </Grid>
         </Grid>
        </Border>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Border>
     <TextBlock Text="{x:Static loc:UiText.RefEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" TextWrapping="Wrap" Margin="12">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Fields.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    </Grid>
   </StackPanel>
  </Border>
  <Expander x:Name="ConnectionSettings" Header="{x:Static loc:UiText.PanelConnectionSettings}" Style="{StaticResource DevicePanelConfigurationStyle}">
   <StackPanel Margin="4,6,4,2">
    <StackPanel Style="{StaticResource DevicePanelFamilyOnlyStyle}">
     <TextBlock Text="{x:Static loc:UiText.RefDeviceInstance}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
     <ComboBox ItemsSource="{Binding Devices}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedDevice}" IsEnabled="{Binding CanSelectInstance}"/>
     <WrapPanel Margin="0,5,0,6" IsEnabled="{Binding CanSelectInstance}">
      <Button Content="{x:Static loc:UiText.New}" Command="{Binding NewDeviceCommand}" Style="{DynamicResource AppToolBarButtonStyle}"/>
      <Button Content="{x:Static loc:UiText.Delete}" Command="{Binding DeleteDeviceCommand}" Style="{DynamicResource AppToolBarButtonStyle}"/>
     </WrapPanel>
    </StackPanel>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="{x:Static loc:UiText.RefModel}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
      <ComboBox ItemsSource="{Binding Models}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedModel}" IsEnabled="{Binding CanEdit}"/>
     </StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="{x:Static loc:UiText.RefResource}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
      <ComboBox ItemsSource="{Binding Resources}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedResource}" IsEnabled="{Binding CanEdit}"/>
     </StackPanel>
    </Grid>
    <Button Content="{x:Static loc:UiText.RefSaveBinding}" Command="{Binding SaveBindingCommand}" IsEnabled="{Binding CanEdit}" Style="{DynamicResource AppToolBarButtonStyle}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
    <TextBlock Text="{Binding ProtocolText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
    <TextBlock Text="{Binding ModelStatus}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0"/>
   </StackPanel>
  </Expander>
  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0">
   <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
 </StackPanel>
</UserControl>
