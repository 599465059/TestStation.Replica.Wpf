<UserControl x:Class="TestStation.App.Devices.ItechPowerSupply.Views.ItechPowerSupplyView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:text="clr-namespace:TestStation.App.Localization"
 Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <DataTemplate x:Key="InputField">
   <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1"><TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsText, Converter={StaticResource Visible}}" IsEnabled="{Binding CanWrite}"/>
     <CheckBox Content="开启" IsChecked="{Binding BoolInput}" Visibility="{Binding IsBoolean, Converter={StaticResource Visible}}" IsEnabled="{Binding CanWrite}"/>
     <TextBlock Text="{Binding Range}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/>
    </StackPanel><TextBlock Grid.Column="2" Text="{Binding Unit}" Margin="8,5,0,0"/>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="Measurement">
   <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,8" Margin="0,0,8,8" MinWidth="175">
    <StackPanel><TextBlock Text="{Binding Name}" Foreground="{DynamicResource MutedBrush}"/>
     <StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="{Binding Display}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="{Binding Unit}" Margin="8,10,0,0"/></StackPanel>
     <TextBlock Text="{Binding Quality}" Foreground="{Binding QualityColor}" ToolTip="{Binding Error}"/>
    </StackPanel>
   </Border>
  </DataTemplate>
 </UserControl.Resources>
 <Grid Margin="12" MinWidth="610">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,10,0"><TextBlock Text="设备实例" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding Devices}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedDevice}" IsEnabled="{Binding CanManage}"/>
    <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Button Content="新增" Command="{Binding AddDeviceCommand}" IsEnabled="{Binding CanManage}" Style="{DynamicResource AppButtonStyle}"/><Button Content="更名" Command="{Binding RenameDeviceCommand}" IsEnabled="{Binding CanConfigure}" Style="{DynamicResource AppButtonStyle}" Margin="4,0"/><Button Content="删除" Command="{Binding RemoveDeviceCommand}" IsEnabled="{Binding CanConfigure}" Style="{DynamicResource AppButtonStyle}"/></StackPanel>
   </StackPanel>
   <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="设备型号" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding Models}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedModel}" IsEnabled="{Binding CanConfigure}"/><TextBlock Text="{Binding Protocol}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" FontSize="11"/></StackPanel>
   <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="通信资源" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding Resources}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedResource}" IsEnabled="{Binding CanConfigure}"/>
    <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Button Content="参数" Command="{Binding EditResourceAsyncCommand}" IsEnabled="{Binding CanConfigure}" Style="{DynamicResource AppButtonStyle}"/><Button Content="新增资源" Command="{Binding NewResourceAsyncCommand}" IsEnabled="{Binding CanManage}" Style="{DynamicResource AppButtonStyle}" Margin="4,0,0,0"/></StackPanel>
   </StackPanel>
   <StackPanel Grid.Column="3" Margin="0,20,0,0"><StackPanel Orientation="Horizontal"><Button Content="连接" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnect}" Style="{DynamicResource AccentButton}" Margin="0,0,5,0"/><Button Content="断开" Command="{Binding DisconnectCommand}" IsEnabled="{Binding CanDisconnect}" Style="{DynamicResource AppButtonStyle}"/></StackPanel><Button Content="保存绑定" Command="{Binding SaveBindingCommand}" IsEnabled="{Binding CanConfigure}" Style="{DynamicResource AppButtonStyle}" Margin="0,5,0,0"/></StackPanel>
  </Grid>
  <Border Grid.Row="1" Margin="0,10,0,10" Padding="8" Background="{DynamicResource ContentBrush}">
   <StackPanel><DockPanel><TextBlock Text="{Binding ConnectionLabel}" FontWeight="SemiBold"/><TextBlock Text="{Binding ResourceSummary}" Margin="18,0,0,0" Foreground="{DynamicResource MutedBrush}"/></DockPanel><TextBlock Text="{Binding Identity}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
  </Border>
  <CheckBox Grid.Row="2" Content="{x:Static text:UiText.HwRefreshAuto}" IsChecked="{Binding AutoRefresh}" IsEnabled="{Binding CanOperate}" Margin="0,0,0,8"/>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <GroupBox Header="输出设定" Margin="0,0,10,0"><StackPanel Margin="10" IsEnabled="{Binding CanOperate}"><ItemsControl ItemsSource="{Binding Setpoints}" ItemTemplate="{StaticResource InputField}"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="应用设定" Command="{Binding ApplyCommand}" Style="{DynamicResource AccentButton}"/><Button Content="读取一次" Command="{Binding ReadCommand}" Style="{DynamicResource AppButtonStyle}" Margin="6,0"/></StackPanel>
    <Border Margin="0,12,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Visibility="{Binding HasOutput, Converter={StaticResource Visible}}"><DockPanel><Button DockPanel.Dock="Right" Content="应用开关" Command="{Binding ApplyOutputCommand}" Style="{DynamicResource AppButtonStyle}"/><CheckBox Content="输出开启" IsChecked="{Binding Output.BoolInput}" VerticalAlignment="Center"/></DockPanel></Border>
   </StackPanel></GroupBox>
   <GroupBox Grid.Column="1" Header="测量读数"><ItemsControl Margin="10" ItemsSource="{Binding Measurements}" ItemTemplate="{StaticResource Measurement}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></GroupBox>
  </Grid>
  <GroupBox Grid.Row="4" Header="保护功能" Margin="0,10,0,0" Visibility="{Binding HasProtection, Converter={StaticResource Visible}}"><ItemsControl ItemsSource="{Binding Protection}" Margin="10" IsEnabled="{Binding CanOperate}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel><Button DockPanel.Dock="Right" Content="写入" Command="{Binding DataContext.WriteFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{DynamicResource AppButtonStyle}"/><ContentControl Content="{Binding}" ContentTemplate="{StaticResource InputField}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></GroupBox>
  <GroupBox Grid.Row="5" Header="扩展通道" Margin="0,10,0,0" Visibility="{Binding HasExtra, Converter={StaticResource Visible}}">
   <DataGrid ItemsSource="{Binding Extra}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsEnabled="{Binding CanOperate}" MaxHeight="260" Margin="8">
    <DataGrid.Columns><DataGridTextColumn Header="通道" Binding="{Binding Name}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="类型" Binding="{Binding Definition.DataType}" IsReadOnly="True"/><DataGridTextColumn Header="当前值" Binding="{Binding Display}" IsReadOnly="True"/><DataGridTextColumn Header="单位" Binding="{Binding Unit}" IsReadOnly="True"/>
     <DataGridTemplateColumn Header="写入值" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsText, Converter={StaticResource Visible}}" IsEnabled="{Binding CanWrite}"/><CheckBox IsChecked="{Binding BoolInput}" Visibility="{Binding IsBoolean, Converter={StaticResource Visible}}" IsEnabled="{Binding CanWrite}"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="状态"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Quality}" Foreground="{Binding QualityColor}" ToolTip="{Binding Error}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="操作"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="读" Command="{Binding DataContext.ReadFieldCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" IsEnabled="{Binding CanRead}" Style="{DynamicResource AppButtonStyle}"/><Button Content="写" Command="{Binding DataContext.WriteFieldCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" IsEnabled="{Binding CanWrite}" Style="{DynamicResource AppButtonStyle}" Margin="4,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
  </GroupBox>
  <StackPanel Grid.Row="6" Margin="0,10,0,0"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><Expander Header="通信记录" Margin="0,8,0,0"><ListBox ItemsSource="{Binding Traffic}" Height="160" FontFamily="Consolas" FontSize="11"/></Expander></StackPanel>
 </Grid>
</UserControl>
