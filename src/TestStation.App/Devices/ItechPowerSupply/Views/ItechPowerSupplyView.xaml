<UserControl x:Class="TestStation.App.Devices.ItechPowerSupply.Views.ItechPowerSupplyView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:text="clr-namespace:TestStation.App.Localization"
 Style="{StaticResource DeviceOperationPanelStyle}" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <DataTemplate x:Key="InputField">
   <Grid Margin="0,3" ToolTip="{Binding Range}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="115"/><ColumnDefinition Width="130"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,8,0"/>
    <Grid Grid.Column="1">
     <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsText, Converter={StaticResource Visible}}" IsEnabled="{Binding CanWrite}"/>
     <CheckBox Content="{x:Static text:UiText.PanelEnabled}" IsChecked="{Binding BoolInput}" Visibility="{Binding IsBoolean, Converter={StaticResource Visible}}" IsEnabled="{Binding CanWrite}"/>
    </Grid>
    <TextBlock Grid.Column="2" Text="{Binding Unit}" VerticalAlignment="Center" Margin="6,0,0,0"/>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="Measurement">
   <StackPanel Margin="0,0,10,0">
    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
    <StackPanel Orientation="Horizontal" Margin="0,2">
     <TextBlock Text="{Binding Display}" FontSize="24" FontWeight="SemiBold" FontFamily="{DynamicResource ReadoutFontFamily}"/>
     <TextBlock Text="{Binding Unit}" Margin="5,0,0,2" VerticalAlignment="Bottom"/>
    </StackPanel>
    <TextBlock Text="{Binding Quality}" Foreground="{Binding QualityColor}" ToolTip="{Binding Error}" FontSize="11"/>
   </StackPanel>
  </DataTemplate>
 </UserControl.Resources>
 <StackPanel x:Name="OperationPanel" Margin="8" MinWidth="360" MaxWidth="720" HorizontalAlignment="Stretch" VerticalAlignment="Top">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding SelectedDevice.Name, TargetNullValue={x:Static text:UiText.RefDeviceInstance}}" Style="{StaticResource DevicePanelTitleStyle}" ToolTip="{Binding SelectedDevice.Name}" Margin="0,0,8,0"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button Content="{x:Static text:UiText.RefConnect}" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnect}" Style="{DynamicResource AppToolBarButtonStyle}"/>
    <Button Content="{x:Static text:UiText.RefDisconnect}" Command="{Binding DisconnectCommand}" IsEnabled="{Binding CanDisconnect}" Style="{DynamicResource AppToolBarButtonStyle}"/>
   </StackPanel>
  </Grid>
  <TextBlock Text="{Binding ConnectionLabel}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
  <TextBlock Text="{x:Static text:UiText.PanelNoDevice}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0">
   <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedDevice}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
  <Border Style="{StaticResource DevicePanelSectionStyle}">
   <StackPanel>
    <DockPanel Margin="0,0,0,6">
     <CheckBox DockPanel.Dock="Right" Content="{x:Static text:UiText.HwRefreshAuto}" IsChecked="{Binding AutoRefresh}" IsEnabled="{Binding CanOperate}" VerticalAlignment="Center"/>
     <TextBlock Text="{x:Static text:UiText.PanelMeasurements}" FontWeight="SemiBold"/>
    </DockPanel>
    <ItemsControl ItemsSource="{Binding Measurements}" ItemTemplate="{StaticResource Measurement}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    </ItemsControl>
   </StackPanel>
  </Border>
  <Border x:Name="SetpointSection" Style="{StaticResource DevicePanelSectionStyle}">
   <StackPanel IsEnabled="{Binding CanOperate}">
    <TextBlock Text="{x:Static text:UiText.PanelOutputSettings}" Style="{StaticResource DevicePanelSectionTitleStyle}"/>
    <ItemsControl ItemsSource="{Binding Setpoints}" ItemTemplate="{StaticResource InputField}"/>
    <WrapPanel Margin="0,6,0,0">
     <Button Content="{x:Static text:UiText.PanelApplySettings}" Command="{Binding ApplyCommand}" Style="{DynamicResource AppToolBarButtonStyle}"/>
     <Button Content="{x:Static text:UiText.RefReadOnce}" Command="{Binding ReadCommand}" Style="{DynamicResource AppToolBarButtonStyle}"/>
    </WrapPanel>
    <Border Margin="0,8,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Visibility="{Binding HasOutput, Converter={StaticResource Visible}}">
     <DockPanel>
      <Button DockPanel.Dock="Right" Content="{x:Static text:UiText.PanelApplyOutput}" Command="{Binding ApplyOutputCommand}" Style="{DynamicResource AppToolBarButtonStyle}"/>
      <CheckBox Content="{x:Static text:UiText.OutputEnabled}" IsChecked="{Binding Output.BoolInput}" VerticalAlignment="Center"/>
     </DockPanel>
    </Border>
   </StackPanel>
  </Border>
  <Expander x:Name="ConnectionSettings" Header="{x:Static text:UiText.PanelConnectionSettings}" Style="{StaticResource DevicePanelConfigurationStyle}">
   <StackPanel Margin="4,6,4,2">
    <StackPanel Style="{StaticResource DevicePanelFamilyOnlyStyle}">
     <TextBlock Text="{x:Static text:UiText.RefDeviceInstance}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
     <ComboBox ItemsSource="{Binding Devices}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedDevice}" IsEnabled="{Binding CanSelectInstance}"/>
     <WrapPanel Margin="0,5,0,6">
      <Button Content="{x:Static text:UiText.New}" Command="{Binding AddDeviceCommand}" IsEnabled="{Binding CanSelectInstance}" Style="{DynamicResource AppToolBarButtonStyle}"/>
      <Button Content="{x:Static text:UiText.Rename}" Command="{Binding RenameDeviceCommand}" IsEnabled="{Binding CanConfigure}" Style="{DynamicResource AppToolBarButtonStyle}"/>
      <Button Content="{x:Static text:UiText.Delete}" Command="{Binding RemoveDeviceCommand}" IsEnabled="{Binding CanConfigure}" Style="{DynamicResource AppToolBarButtonStyle}"/>
     </WrapPanel>
    </StackPanel>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="{x:Static text:UiText.RefModel}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
      <ComboBox ItemsSource="{Binding Models}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedModel}" IsEnabled="{Binding CanConfigure}"/>
     </StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="{x:Static text:UiText.RefResource}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
      <ComboBox ItemsSource="{Binding Resources}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedResource}" IsEnabled="{Binding CanConfigure}"/>
     </StackPanel>
    </Grid>
    <WrapPanel Margin="0,6,0,0">
     <Button Content="{x:Static text:UiText.RefSaveBinding}" Command="{Binding SaveBindingCommand}" IsEnabled="{Binding CanConfigure}" Style="{DynamicResource AppToolBarButtonStyle}"/>
     <Button Content="{x:Static text:UiText.PanelResourceParameters}" Command="{Binding EditResourceCommand}" IsEnabled="{Binding CanConfigure}" Style="{DynamicResource AppToolBarButtonStyle}"/>
     <Button Content="{x:Static text:UiText.PanelNewResource}" Command="{Binding NewResourceCommand}" IsEnabled="{Binding CanManage}" Style="{DynamicResource AppToolBarButtonStyle}"/>
    </WrapPanel>
    <TextBlock Text="{Binding Protocol}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
    <TextBlock Text="{Binding ResourceSummary}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
    <TextBlock Text="{Binding Identity}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
   </StackPanel>
  </Expander>
  <Expander Header="{x:Static text:UiText.PanelProtection}" Style="{StaticResource DevicePanelDetailsStyle}" Visibility="{Binding HasProtection, Converter={StaticResource Visible}}">
   <ItemsControl ItemsSource="{Binding Protection}" Margin="4,6" IsEnabled="{Binding CanOperate}">
    <ItemsControl.ItemTemplate><DataTemplate>
     <DockPanel>
      <Button DockPanel.Dock="Right" Content="{x:Static text:UiText.RefWrite}" Command="{Binding DataContext.WriteFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{DynamicResource AppToolBarButtonStyle}" Margin="4,0,0,0"/>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource InputField}"/>
     </DockPanel>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </Expander>
  <Expander Header="{x:Static text:UiText.PanelExtraChannels}" Style="{StaticResource DevicePanelDetailsStyle}" Visibility="{Binding HasExtra, Converter={StaticResource Visible}}">
   <DataGrid ItemsSource="{Binding Extra}" Style="{StaticResource AppDataGridStyle}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
    IsEnabled="{Binding CanOperate}" MaxHeight="250" MinHeight="90" Margin="0,6,0,0" HeadersVisibility="Column" RowHeaderWidth="0" ColumnHeaderHeight="30" RowHeight="32"
    CanUserResizeColumns="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
    <DataGrid.Columns>
     <DataGridTextColumn Header="{x:Static text:UiText.RefChannel}" Binding="{Binding Name}" IsReadOnly="True" Width="*" MinWidth="150" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
     <DataGridTextColumn Header="{x:Static text:UiText.RefDataType}" Binding="{Binding Definition.DataType}" IsReadOnly="True" Width="80" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
     <DataGridTextColumn Header="{x:Static text:UiText.Value}" Binding="{Binding Display}" IsReadOnly="True" Width="100" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
     <DataGridTextColumn Header="{x:Static text:UiText.Unit}" Binding="{Binding Unit}" IsReadOnly="True" Width="60" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
     <DataGridTemplateColumn Header="{x:Static text:UiText.RefInput}" Width="130" MinWidth="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid>
      <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsText, Converter={StaticResource Visible}}" IsEnabled="{Binding CanWrite}"/>
      <CheckBox IsChecked="{Binding BoolInput}" Visibility="{Binding IsBoolean, Converter={StaticResource Visible}}" IsEnabled="{Binding CanWrite}"/>
     </Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="{x:Static text:UiText.Status}" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Quality}" Foreground="{Binding QualityColor}" ToolTip="{Binding Error}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="{x:Static text:UiText.RefOperations}" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal">
      <Button Content="{x:Static text:UiText.RefRead}" Command="{Binding DataContext.ReadFieldCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" IsEnabled="{Binding CanRead}" Style="{DynamicResource AppToolBarButtonStyle}"/>
      <Button Content="{x:Static text:UiText.RefWrite}" Command="{Binding DataContext.WriteFieldCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" IsEnabled="{Binding CanWrite}" Style="{DynamicResource AppToolBarButtonStyle}"/>
     </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
  </Expander>
  <Expander Header="{x:Static text:UiText.PanelTraffic}" Style="{StaticResource DevicePanelDetailsStyle}">
   <ListBox ItemsSource="{Binding Traffic}" Height="150" FontFamily="Consolas" FontSize="11" Margin="0,6,0,0"/>
  </Expander>
  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0" ToolTip="{Binding Status}">
   <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
    <DataTrigger Binding="{Binding Status}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
   </Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
 </StackPanel>
</UserControl>
