<UserControl x:Class="TestStation.App.Devices.ItechPowerSupply.Views.ItechPowerSupplyAdminView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:app="clr-namespace:TestStation.Application.Devices.ItechPowerSupply;assembly=TestStation.Application"
 Foreground="{DynamicResource TextBrush}">
 <Grid Margin="12" MinWidth="640"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,10" IsEnabled="{Binding CanEdit}"><Button Content="校验" Command="{Binding ValidateCommand}" Style="{DynamicResource AppButtonStyle}"/><Button Content="保存" Command="{Binding SaveCommand}" Style="{DynamicResource AccentButton}" Margin="6,0"/><Button Content="放弃修改" Command="{Binding DiscardCommand}" Style="{DynamicResource AppButtonStyle}"/><Button Content="恢复默认" Command="{Binding ResetCommand}" Style="{DynamicResource AppButtonStyle}" Margin="6,0"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <ListBox ItemsSource="{Binding Categories}" SelectedIndex="{Binding CategoryIndex}" Margin="0,0,12,0"/>
   <Grid Grid.Column="1">

<Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CategoryIndex}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding CanEdit}"><Button Content="新增型号" Command="{Binding AddModelCommand}" Style="{DynamicResource AppButtonStyle}"/><Button Content="删除型号" Command="{Binding RemoveModelCommand}" Style="{DynamicResource AppButtonStyle}" Margin="6,0"/></StackPanel>
 <DataGrid x:Name="ModelGrid" Grid.Row="1" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="150" MaxHeight="260" IsEnabled="{Binding CanEdit}" BeginningEdit="ModelBeginningEdit" CellEditEnding="Edited" HeadersVisibility="Column" RowHeaderWidth="0" ColumnHeaderHeight="32" RowHeight="30" CanUserResizeColumns="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
 <DataGrid.Columns><DataGridTextColumn Header="标识" Binding="{Binding Id}" Width="150" MinWidth="130" ElementStyle="{StaticResource AppDataGridTextStyle}"/><DataGridTextColumn Header="型号名称" Binding="{Binding Name}" Width="2*" MinWidth="220" ElementStyle="{StaticResource AppDataGridTextStyle}"/><DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="75" MinWidth="65"/></DataGrid.Columns></DataGrid>
 <StackPanel Grid.Row="2" Margin="0,12,0,0" IsEnabled="{Binding CanEdit}"><TextBlock Text="型号能力" FontWeight="SemiBold"/><WrapPanel Margin="0,8"><CheckBox Content="电压" IsChecked="{Binding SelectedModel.Voltage}" Margin="0,0,14,0"/><CheckBox Content="电流" IsChecked="{Binding SelectedModel.Current}" Margin="0,0,14,0"/><CheckBox Content="输出开关" IsChecked="{Binding SelectedModel.Output}" Margin="0,0,14,0"/><CheckBox Content="保护功能" IsChecked="{Binding SelectedModel.Protection}" Margin="0,0,14,0"/><CheckBox Content="双向源/载" IsChecked="{Binding SelectedModel.Bidirectional}" Margin="0,0,14,0"/><CheckBox Content="光伏模式" IsChecked="{Binding SelectedModel.Photovoltaic}"/></WrapPanel>
 <WrapPanel><TextBlock Text="最大电压(V)" VerticalAlignment="Center"/><TextBox Text="{Binding SelectedModel.MaxVoltage}" Width="82" Margin="8,0,14,0"/><TextBlock Text="最大电流(A)" VerticalAlignment="Center"/><TextBox Text="{Binding SelectedModel.MaxCurrent}" Width="82" Margin="8,0,14,0"/><TextBlock Text="最大功率(W)" VerticalAlignment="Center"/><TextBox Text="{Binding SelectedModel.MaxPower}" Width="90" Margin="8,0,14,0"/><TextBlock Text="通道数" VerticalAlignment="Center"/><TextBox Text="{Binding SelectedModel.ChannelCount}" Width="55" Margin="8,0"/></WrapPanel>
 <TextBlock Text="通信与驱动" FontWeight="SemiBold" Margin="0,16,0,8"/><WrapPanel><CheckBox Content="TCP" IsChecked="{Binding SelectedModel.Tcp}" Margin="0,0,16,0"/><CheckBox Content="串口" IsChecked="{Binding SelectedModel.Serial}" Margin="0,0,16,0"/><CheckBox Content="VISA（尚未接入）" IsEnabled="False" Margin="0,0,16,0"/><CheckBox Content="CAN（尚未接入）" IsEnabled="False"/></WrapPanel>
 <TextBlock Text="SCPI · itech.public-scpi" Foreground="{DynamicResource MutedBrush}" Margin="0,8"/>
 </StackPanel></Grid>
<Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CategoryIndex}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <WrapPanel IsEnabled="{Binding CanEdit}"><TextBlock Text="配置对象" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Targets}" SelectedIndex="{Binding TargetIndex}" Width="240" Margin="8,0"/><Button Content="建立型号覆盖" Command="{Binding OverrideChannelsCommand}" Style="{DynamicResource AppButtonStyle}"/><Button Content="恢复继承" Command="{Binding InheritChannelsCommand}" Style="{DynamicResource AppButtonStyle}" Margin="6,0"/></WrapPanel>
 <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8" IsEnabled="{Binding ChannelsEditable}"><Button Content="添加通道" Command="{Binding AddChannelCommand}" Style="{DynamicResource AppButtonStyle}"/><Button Content="删除／停用" Command="{Binding RemoveChannelCommand}" Style="{DynamicResource AppButtonStyle}" Margin="6,0"/></StackPanel>
 <DataGrid Grid.Row="2" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsEnabled="{Binding ChannelsEditable}" MinHeight="260" MaxHeight="500" BeginningEdit="ChannelBeginningEdit" CellEditEnding="Edited" HeadersVisibility="Column" RowHeaderWidth="0" ColumnHeaderHeight="34" RowHeight="30" CanUserResizeColumns="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"><DataGrid.Columns>
<DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="65" MinWidth="60"/>
<DataGridTextColumn Header="通道标识" Binding="{Binding Id}" Width="190" MinWidth="160" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
<DataGridTextColumn Header="显示名" Binding="{Binding DisplayName}" Width="170" MinWidth="130" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
<DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="85" MinWidth="65" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
<DataGridTextColumn Header="下限" Binding="{Binding Minimum}" Width="95" MinWidth="80" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
<DataGridTextColumn Header="上限" Binding="{Binding Maximum}" Width="95" MinWidth="80" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
<DataGridComboBoxColumn Header="类型" ItemsSource="{x:Static app:PowerSupplyValidation.Types}" SelectedItemBinding="{Binding DataType}" Width="105" MinWidth="95"/>
<DataGridComboBoxColumn Header="功能绑定" ItemsSource="{x:Static app:PowerSupplyValidation.Bindings}" SelectedItemBinding="{Binding Binding}" Width="155" MinWidth="135"/>
<DataGridCheckBoxColumn Header="读" Binding="{Binding CanRead}" Width="60" MinWidth="55"/>
<DataGridCheckBoxColumn Header="写" Binding="{Binding CanWrite}" Width="60" MinWidth="55"/>
</DataGrid.Columns></DataGrid></Grid>
<Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CategoryIndex}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <WrapPanel IsEnabled="{Binding CanEdit}"><TextBlock Text="配置对象" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Targets}" SelectedIndex="{Binding TargetIndex}" Width="240" Margin="8,0"/><Button Content="建立型号覆盖" Command="{Binding OverrideChannelsCommand}" Style="{DynamicResource AppButtonStyle}"/><Button Content="恢复继承" Command="{Binding InheritChannelsCommand}" Style="{DynamicResource AppButtonStyle}" Margin="6,0"/></WrapPanel>
 <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8" IsEnabled="{Binding ChannelsEditable}"><Button Content="添加通道" Command="{Binding AddChannelCommand}" Style="{DynamicResource AppButtonStyle}"/><Button Content="删除／停用" Command="{Binding RemoveChannelCommand}" Style="{DynamicResource AppButtonStyle}" Margin="6,0"/></StackPanel>
 <DataGrid Grid.Row="2" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsEnabled="{Binding ChannelsEditable}" MinHeight="260" MaxHeight="500" BeginningEdit="ChannelBeginningEdit" CellEditEnding="Edited" HeadersVisibility="Column" RowHeaderWidth="0" ColumnHeaderHeight="34" RowHeight="30" CanUserResizeColumns="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"><DataGrid.Columns>
<DataGridTextColumn Header="通道" Binding="{Binding DisplayName}" IsReadOnly="True" Width="150" MinWidth="120" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
<DataGridTextColumn Header="读取指令" Binding="{Binding ReadCommand}" Width="165" MinWidth="130" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
<DataGridTextColumn Header="写入模板" Binding="{Binding WriteCommand}" Width="175" MinWidth="140" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
<DataGridTextColumn Header="比例" Binding="{Binding Scale}" Width="85" MinWidth="75" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
<DataGridTextColumn Header="偏移" Binding="{Binding Offset}" Width="85" MinWidth="75" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
<DataGridTextColumn Header="真响应（|分隔）" Binding="{Binding TrueResponse}" Width="165" MinWidth="140" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
<DataGridTextColumn Header="假响应（|分隔）" Binding="{Binding FalseResponse}" Width="165" MinWidth="140" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
<DataGridTextColumn Header="真写入" Binding="{Binding TrueCommand}" Width="135" MinWidth="110" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
<DataGridTextColumn Header="假写入" Binding="{Binding FalseCommand}" Width="135" MinWidth="110" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
</DataGrid.Columns></DataGrid></Grid>
<Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CategoryIndex}" Value="3"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <WrapPanel IsEnabled="{Binding CanEdit}"><TextBlock Text="配置对象" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Targets}" SelectedIndex="{Binding TargetIndex}" Width="240" Margin="8,0"/><Button Content="建立型号覆盖" Command="{Binding OverrideChannelsCommand}" Style="{DynamicResource AppButtonStyle}"/><Button Content="恢复继承" Command="{Binding InheritChannelsCommand}" Style="{DynamicResource AppButtonStyle}" Margin="6,0"/></WrapPanel>
 <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8" IsEnabled="{Binding ChannelsEditable}"><Button Content="添加通道" Command="{Binding AddChannelCommand}" Style="{DynamicResource AppButtonStyle}"/><Button Content="删除／停用" Command="{Binding RemoveChannelCommand}" Style="{DynamicResource AppButtonStyle}" Margin="6,0"/></StackPanel>
 <DataGrid Grid.Row="2" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsEnabled="{Binding ChannelsEditable}" MinHeight="260" MaxHeight="500" BeginningEdit="ChannelBeginningEdit" CellEditEnding="Edited" HeadersVisibility="Column" RowHeaderWidth="0" ColumnHeaderHeight="34" RowHeight="30" CanUserResizeColumns="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"><DataGrid.Columns>
<DataGridTextColumn Header="通道" Binding="{Binding DisplayName}" IsReadOnly="True" Width="2*" MinWidth="220" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
<DataGridCheckBoxColumn Header="手动轮询" Binding="{Binding Poll}" Width="105" MinWidth="95"/>
<DataGridTextColumn Header="周期(ms)" Binding="{Binding IntervalMs}" Width="120" MinWidth="105" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
<DataGridTextColumn Header="超时(ms)" Binding="{Binding TimeoutMs}" Width="120" MinWidth="105" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
</DataGrid.Columns></DataGrid></Grid>
</Grid></Grid><TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,0"/></Grid></UserControl>
