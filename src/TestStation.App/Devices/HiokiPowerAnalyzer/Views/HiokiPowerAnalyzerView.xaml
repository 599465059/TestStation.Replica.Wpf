<UserControl x:Class="TestStation.App.Devices.HiokiPowerAnalyzer.Views.HiokiPowerAnalyzerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:text="clr-namespace:TestStation.App.Localization"
 Style="{StaticResource DeviceOperationPanelStyle}" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}">
 <StackPanel x:Name="OperationPanel" Margin="8" MinWidth="360" MaxWidth="900" VerticalAlignment="Top">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding SelectedDevice.Name, TargetNullValue={x:Static text:UiText.RefDeviceInstance}}" Style="{StaticResource DevicePanelTitleStyle}" ToolTip="{Binding SelectedDevice.Name}" Margin="0,0,8,0"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button Content="{x:Static text:UiText.RefConnect}" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnect}" Style="{DynamicResource AppToolBarButtonStyle}"/>
    <Button Content="{x:Static text:UiText.RefDisconnect}" Command="{Binding DisconnectCommand}" IsEnabled="{Binding CanDisconnect}" Style="{DynamicResource AppToolBarButtonStyle}"/>
   </StackPanel>
  </Grid>
  <TextBlock Text="{Binding ConnectionLabel}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
  <Border Style="{StaticResource DevicePanelSectionStyle}">
   <StackPanel>
    <DockPanel Margin="0,0,0,6">
     <WrapPanel DockPanel.Dock="Right">
      <CheckBox Content="{x:Static text:UiText.HwRefreshAuto}" IsChecked="{Binding AutoRefresh}" IsEnabled="{Binding CanOperate}" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <Button Content="{x:Static text:UiText.RefReadOnce}" Command="{Binding ReadOnceCommand}" IsEnabled="{Binding CanOperate}" Style="{DynamicResource AppToolBarButtonStyle}"/>
     </WrapPanel>
     <TextBlock Text="{x:Static text:UiText.PanelMeasurements}" FontWeight="SemiBold"/>
    </DockPanel>
    <Grid>
     <DataGrid x:Name="MeasurementGrid" ItemsSource="{Binding Fields}" Style="{StaticResource AppDataGridStyle}" AutoGenerateColumns="False"
      CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0" ColumnHeaderHeight="30" RowHeight="28"
      CanUserResizeColumns="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" MinHeight="150" MaxHeight="320">
      <DataGrid.Columns>
       <DataGridTextColumn Header="{x:Static text:UiText.RefChannel}" Binding="{Binding Name}" Width="*" MinWidth="135" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
       <DataGridTextColumn Header="{x:Static text:UiText.Value}" Binding="{Binding Display}" Width="100" MinWidth="90" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
       <DataGridTextColumn Header="{x:Static text:UiText.Unit}" Binding="{Binding Unit}" Width="50" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
       <DataGridTemplateColumn Header="{x:Static text:UiText.Status}" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate>
        <TextBlock Text="{Binding Quality}" Foreground="{Binding QualityColor}" ToolTip="{Binding Error}" VerticalAlignment="Center"/>
       </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock Text="{x:Static text:UiText.PanelNoHioki}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" TextWrapping="Wrap">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasFields}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    </Grid>
   </StackPanel>
  </Border>
  <Expander x:Name="ConnectionSettings" Header="{x:Static text:UiText.PanelConnectionSettings}" Style="{StaticResource DevicePanelConfigurationStyle}">
   <StackPanel Margin="4,6,4,2">
    <StackPanel Style="{StaticResource DevicePanelFamilyOnlyStyle}">
     <TextBlock Text="{x:Static text:UiText.RefDeviceInstance}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
     <ComboBox ItemsSource="{Binding Devices}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedDevice}" IsEnabled="{Binding CanSelectInstance}"/>
     <WrapPanel Margin="0,5,0,6">
      <Button Content="{x:Static text:UiText.New}" Command="{Binding AddDeviceCommand}" IsEnabled="{Binding CanSelectInstance}" Style="{DynamicResource AppToolBarButtonStyle}"/>
      <Button Content="{x:Static text:UiText.Rename}" Command="{Binding RenameDeviceCommand}" IsEnabled="{Binding CanConfigure}" Style="{DynamicResource AppToolBarButtonStyle}"/>
      <Button Content="{x:Static text:UiText.Delete}" Command="{Binding RemoveDeviceCommand}" IsEnabled="{Binding CanConfigure}" Style="{DynamicResource AppToolBarButtonStyle}"/>
     </WrapPanel>
    </StackPanel>
    <TextBlock Text="HIOKI PW6001 · SCPI · TCP" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
    <ComboBox ItemsSource="{Binding Resources}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedResource}" IsEnabled="{Binding CanConfigure}" ToolTip="{x:Static text:UiText.RefResource}"/>
    <WrapPanel Margin="0,6,0,0">
     <Button Content="{x:Static text:UiText.RefSaveBinding}" Command="{Binding SaveBindingCommand}" IsEnabled="{Binding CanConfigure}" Style="{DynamicResource AppToolBarButtonStyle}"/>
     <Button Content="{x:Static text:UiText.PanelResourceParameters}" Command="{Binding EditResourceCommand}" IsEnabled="{Binding CanConfigure}" Style="{DynamicResource AppToolBarButtonStyle}"/>
     <Button Content="{x:Static text:UiText.PanelNewResource}" Command="{Binding NewResourceCommand}" IsEnabled="{Binding CanManage}" Style="{DynamicResource AppToolBarButtonStyle}"/>
    </WrapPanel>
    <TextBlock Text="{Binding ResourceSummary}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
    <TextBlock Text="{Binding Identity}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
   </StackPanel>
  </Expander>
  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0">
   <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
 </StackPanel>
</UserControl>
