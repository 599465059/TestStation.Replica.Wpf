<UserControl x:Class="TestStation.App.Devices.HiokiPowerAnalyzer.Views.HiokiPowerAnalyzerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:text="clr-namespace:TestStation.App.Localization"
 Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/></UserControl.Resources>
 <Grid Margin="12" MinWidth="720">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,8,0"><TextBlock Text="设备实例" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding Devices}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedDevice}" IsEnabled="{Binding CanManage}"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Button Content="新增" Command="{Binding AddDeviceCommand}" Style="{DynamicResource AppButtonStyle}"/><Button Content="更名" Command="{Binding RenameDeviceCommand}" Style="{DynamicResource AppButtonStyle}" Margin="4,0"/><Button Content="删除" Command="{Binding RemoveDeviceCommand}" Style="{DynamicResource AppButtonStyle}" Margin="4,0"/></StackPanel></StackPanel>
   <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="型号"/><TextBlock Text="HIOKI PW6001" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="SCPI · TCP" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
   <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="通信资源" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding Resources}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedResource}" IsEnabled="{Binding CanConfigure}"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Button Content="参数" Command="{Binding EditResourceAsyncCommand}" IsEnabled="{Binding CanConfigure}" Style="{DynamicResource AppButtonStyle}"/><Button Content="新增资源" Command="{Binding NewResourceAsyncCommand}" IsEnabled="{Binding CanManage}" Style="{DynamicResource AppButtonStyle}" Margin="4,0"/></StackPanel></StackPanel>
   <StackPanel Grid.Column="3" Margin="0,20,0,0"><StackPanel Orientation="Horizontal"><Button Content="连接" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnect}" Style="{DynamicResource AccentButton}" Margin="0,0,5,0"/><Button Content="断开" Command="{Binding DisconnectCommand}" IsEnabled="{Binding CanDisconnect}" Style="{DynamicResource AppButtonStyle}"/></StackPanel><Button Content="保存绑定" Command="{Binding SaveBindingCommand}" IsEnabled="{Binding CanConfigure}" Style="{DynamicResource AppButtonStyle}" Margin="0,5,0,0"/></StackPanel>
  </Grid>
  <Border Grid.Row="1" Margin="0,10,0,10" Padding="8" Background="{DynamicResource ContentBrush}"><StackPanel><DockPanel><TextBlock Text="{Binding ConnectionLabel}" FontWeight="SemiBold"/><TextBlock Text="{Binding ResourceSummary}" Margin="18,0,0,0" Foreground="{DynamicResource MutedBrush}"/></DockPanel><TextBlock Text="{Binding Identity}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border>
  <CheckBox Grid.Row="2" Content="{x:Static text:UiText.HwRefreshAuto}" IsChecked="{Binding AutoRefresh}" IsEnabled="{Binding CanOperate}" Margin="0,0,0,8"/>
  <Grid Grid.Row="3" Margin="0,0,0,10">
   <DataGrid ItemsSource="{Binding Fields}" Style="{StaticResource AppDataGridStyle}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0" ColumnHeaderHeight="32" RowHeight="30" CanUserResizeColumns="True" GridLinesVisibility="All" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
    <DataGrid.Columns>
     <DataGridTextColumn Header="通道" Binding="{Binding Name}" Width="*" MinWidth="320" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
     <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="90" MinWidth="80" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
     <DataGridTextColumn Header="当前值" Binding="{Binding Display}" Width="150" MinWidth="130" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
     <DataGridTemplateColumn Header="状态" Width="100" MinWidth="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Quality}" Foreground="{Binding QualityColor}" ToolTip="{Binding Error}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Text="尚未创建 HIOKI 设备实例" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False">
    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasFields}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
  </Grid>
  <StackPanel Grid.Row="4" Orientation="Horizontal"><Button Content="读取一次" Command="{Binding ReadOnceCommand}" IsEnabled="{Binding CanOperate}" Style="{DynamicResource AccentButton}"/><TextBlock Text="{Binding Status}" Margin="10,5,0,0" TextWrapping="Wrap"/></StackPanel>
 </Grid>
</UserControl>
