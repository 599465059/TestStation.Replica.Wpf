<Window x:Class="TestStation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:text="clr-namespace:TestStation.App.Localization"
        xmlns:local="clr-namespace:TestStation.App"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:kit="clr-namespace:Industrial.Controls;assembly=Industrial.Controls"
        Title="{x:Static text:UiText.ProductName}" Width="1440" Height="900" MinWidth="1080" MinHeight="640"
        ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <kit:DialogHost x:Name="AppDialogHost" Background="{DynamicResource WindowBrush}">
    <Border x:Name="ShellFrame" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" Background="{DynamicResource WindowBrush}">
    <Grid x:Name="ShellRoot">
        <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="30"/><RowDefinition Height="*" MinHeight="0"/><RowDefinition Height="26"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="{DynamicResource WindowBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                <md:PackIcon Kind="ViewDashboardOutline" Foreground="{DynamicResource AccentBrush}" Width="17" Height="17" Margin="0,0,10,0"/>
                <TextBlock Text="{x:Static text:UiText.ProductName}" FontWeight="SemiBold"/>
                <TextBlock Text="  ·  " Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock Text="{Binding ProjectName}" Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="AccentBlueButton" Tag="Blue" Background="{DynamicResource BlueSwatchBrush}" BorderBrush="{DynamicResource AccentBrush}" ToolTip="{x:Static text:UiText.AccentBlue}" Style="{StaticResource AccentSwatchButton}" Click="Accent_Click"/>
                <Button x:Name="AccentPurpleButton" Tag="Purple" Background="{DynamicResource PurpleSwatchBrush}" BorderBrush="{DynamicResource BorderBrush}" ToolTip="{x:Static text:UiText.AccentPurple}" Style="{StaticResource AccentSwatchButton}" Click="Accent_Click"/>
                <Button x:Name="AccentTealButton" Tag="Teal" Background="{DynamicResource TealSwatchBrush}" BorderBrush="{DynamicResource BorderBrush}" ToolTip="{x:Static text:UiText.AccentTeal}" Style="{StaticResource AccentSwatchButton}" Click="Accent_Click"/>
                <Button x:Name="ThemeButton" ToolTip="{x:Static text:UiText.SwitchTheme}" Style="{StaticResource IconButton}" Click="Theme_Click"><md:PackIcon Kind="Brightness6" Width="16" Height="16"/></Button>
                <Button x:Name="PinButton" ToolTip="{x:Static text:UiText.Pin}" Style="{StaticResource IconButton}" Click="Pin_Click"><md:PackIcon Kind="PinOutline" Width="16" Height="16"/></Button>
                <Button ToolTip="{x:Static text:UiText.Minimize}" Style="{StaticResource IconButton}" Click="Minimize_Click"><md:PackIcon Kind="WindowMinimize" Width="16" Height="16"/></Button>
                <Button ToolTip="{x:Static text:UiText.MaximizeRestore}" Style="{StaticResource IconButton}" Click="Maximize_Click"><md:PackIcon Kind="WindowMaximize" Width="16" Height="16"/></Button>
                <Button x:Name="CloseWindowButton" AutomationProperties.AutomationId="CloseWindow" ToolTip="{x:Static text:UiText.Close}" Style="{StaticResource IconButton}" Click="Close_Click"><md:PackIcon Kind="Close" Width="16" Height="16"/></Button>
            </StackPanel>
        </Grid>
        <Menu x:Name="ShellMenu" Grid.Row="1" Style="{StaticResource ShellMenuStyle}" Padding="5,0" AutomationProperties.AutomationId="ShellMenu">
            <MenuItem x:Name="FileMenu" Header="{x:Static text:UiText.File}" Style="{StaticResource ShellMenuItem}">
                <MenuItem Header="{x:Static text:UiText.NewProject}" Click="CreateProject_Click"><MenuItem.Icon><md:PackIcon Kind="FilePlusOutline" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{x:Static text:UiText.OpenProject}" Click="OpenProject_Click"><MenuItem.Icon><md:PackIcon Kind="FolderOpenOutline" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{x:Static text:UiText.SaveProject}" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+S"><MenuItem.Icon><md:PackIcon Kind="ContentSaveOutline" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
                <Separator/>
                <MenuItem Header="{x:Static text:UiText.Exit}" Click="Close_Click"><MenuItem.Icon><md:PackIcon Kind="ExitToApp" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
            </MenuItem>
            <MenuItem Header="{x:Static text:UiText.Edit}" Style="{StaticResource SequenceShellMenuItem}">
                <MenuItem Header="{x:Static text:UiText.ApplyStepProperties}" Command="{Binding ApplyStepCommand}"/>
                <MenuItem Header="{x:Static text:UiText.DeleteSelectedSteps}" Command="{Binding DeleteStepCommand}"/>
            </MenuItem>
            <MenuItem Header="{x:Static text:UiText.View}" Style="{StaticResource ShellMenuItem}">
                <MenuItem Header="{x:Static text:UiText.ToggleNavigation}" Click="ToggleNavigation_Click"/>
                <MenuItem Header="{x:Static text:UiText.AutomaticTest}" Tag="自动测试" Click="NavigateMenu_Click"/>
                <MenuItem Header="{x:Static text:UiText.ManualTest}" Tag="手动测试" Click="NavigateMenu_Click"/>
                <MenuItem Header="{x:Static text:UiText.Devices}" Tag="devices" Click="NavigateMenu_Click"/>
                <MenuItem Header="{x:Static text:UiText.HardwareConfig}" Tag="hardware" Click="NavigateMenu_Click"/>
                <MenuItem Header="{x:Static text:UiText.PluginManagement}" Tag="插件管理" Click="NavigateMenu_Click"/>
                <MenuItem Header="{x:Static text:UiText.Settings}" Tag="settings" Click="NavigateMenu_Click"/>
                <MenuItem Header="{x:Static text:UiText.RestoreLayout}" Click="RestoreLayout_Click"/>
            </MenuItem>
            <MenuItem Header="{x:Static text:UiText.Help}" Style="{StaticResource ShellMenuItem}">
                <MenuItem Header="{x:Static text:UiText.About}" Click="About_Click"/>
            </MenuItem>
        </Menu>
            <Grid Grid.Row="2" MinHeight="0" ClipToBounds="True">
            <StackPanel x:Name="StartupView" VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="980" Margin="24,0">
                <TextBlock Text="{x:Static text:UiText.ProductName}" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Static text:UiText.StartupHint}" Margin="0,12,0,28" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="{x:Static text:UiText.NewProject}" Width="145" Height="40" Margin="0,0,12,0" Click="CreateProject_Click"/>
                    <Button Content="{x:Static text:UiText.OpenProject}" Width="145" Height="40" Click="OpenProject_Click"/>
                </StackPanel>
                <TextBlock Text="{x:Static text:UiText.RecentProjects}" Margin="0,28,0,8"/>
                <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ListBox x:Name="RecentList" MinHeight="180" MaxHeight="232" MouseDoubleClick="RecentList_MouseDoubleClick" SelectionChanged="RecentList_SelectionChanged"
                         ItemContainerStyle="{StaticResource RecentProjectItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel ToolTip="{Binding Path}">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- Project preview: what the selected recent project contains, read without opening it. -->
                <Border x:Name="ProjectPreviewCard" Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16,12" Visibility="Collapsed" AutomationProperties.AutomationId="ProjectPreview">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="{x:Static text:UiText.PreviewOpen}" Style="{DynamicResource AccentButton}" Click="PreviewOpen_Click"/>
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="{x:Static text:UiText.WorkbenchMainSequence}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,16,3"/>
                            <TextBlock Grid.Column="1" Text="{Binding MainSequences}" TextTrimming="CharacterEllipsis" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Text="{x:Static text:UiText.WorkbenchSequences}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,16,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SequenceCount}" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Text="{x:Static text:UiText.HwInstances}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,16,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,3"><Run Text="{Binding DeviceCount, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Families, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/></TextBlock>
                            <TextBlock Grid.Row="3" Text="{x:Static text:UiText.HwResources}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,16,3"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ResourceCount}" Margin="0,3"/>
                            <TextBlock Grid.Row="4" Text="{x:Static text:UiText.PreviewLastRun}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,16,3"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LastRun}" Margin="0,3">
                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                    <DataTrigger Binding="{Binding LastRunKind}" Value="success"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding LastRunKind}" Value="error"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
                                </Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,8,0,0">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasProblem}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                </Grid>
            </StackPanel>
            <Grid x:Name="WorkspaceView" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="228" MinWidth="64"/><ColumnDefinition Width="*" MinWidth="0"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <!-- Current project and quick switch. Reuses the File menu handlers. -->
                        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,6">
                            <Button x:Name="ProjectSwitchButton" AutomationProperties.AutomationId="ProjectSwitch" Style="{StaticResource NavButton}" Margin="0" Padding="8,6"
                                    HorizontalContentAlignment="Stretch" ToolTip="{Binding ProjectPath}" Click="ProjectSwitch_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <md:PackIcon Kind="FolderOpenOutline" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ProjectSwitchName" Grid.Column="1" Text="{Binding ProjectName}" FontWeight="SemiBold" Margin="10,0,6,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <md:PackIcon x:Name="ProjectSwitchChevron" Grid.Column="2" Kind="UnfoldMoreHorizontal" Width="16" Height="16" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{x:Static text:UiText.OpenProject}" Click="OpenProject_Click"><MenuItem.Icon><md:PackIcon Kind="FolderOpenOutline" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
                                        <MenuItem Header="{x:Static text:UiText.NewProject}" Click="CreateProject_Click"><MenuItem.Icon><md:PackIcon Kind="FilePlusOutline" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Border>
                        <kit:NavigationView x:Name="NavigationItems" Grid.Row="1" Width="228" MinWidth="64" IsExpanded="True" HorizontalAlignment="Left" VerticalAlignment="Stretch" />
                        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="4,3" HorizontalAlignment="Stretch">
                            <Button x:Name="NavigationToggleButton" ToolTip="{x:Static text:UiText.CollapseNavigation}" Style="{StaticResource IconButton}" Click="ToggleNavigation_Click" HorizontalAlignment="Left" Width="34" Height="30" Padding="0">
                                <md:PackIcon x:Name="NavigationToggleIcon" Kind="MenuOpen" Width="16" Height="16"/>
                            </Button>
                        </Border>
                    </Grid>
                </Border>
                <Grid Grid.Column="1">
                    <Grid x:Name="OverviewView" Visibility="Collapsed">
                    <ContentControl x:Name="WorkbenchHost"/>
                    <Grid x:Name="LegacyOverview">
                        <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="28,0,28,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,9">
                                <TextBlock Text="{x:Static text:UiText.Workbench}" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Static text:UiText.WorkspaceSubtitle}" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="28,25,28,0">
                            <TextBlock Text="{x:Static text:UiText.CurrentProject}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Text="{Binding ProjectName}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,10"/>
                            <TextBlock Text="{Binding ProjectPath}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectPath}"/>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,22,0,15"/>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Width="155"><TextBlock Text="{x:Static text:UiText.TestSequence}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding Sequences.Count}" FontSize="18" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel Width="155"><TextBlock Text="{x:Static text:UiText.SimulatedChannel}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding SimulationValues.Count}" FontSize="18" Margin="0,5,0,0"/></StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    </Grid>
                    <ContentControl x:Name="ManualTestHost" Visibility="Collapsed"/>
                    <ContentControl x:Name="PluginManagementHost" Visibility="Collapsed"/>
                    <ContentControl x:Name="DeviceTestingHost" Visibility="Collapsed"/>
                    <ContentControl x:Name="CanTestHost" Visibility="Collapsed"/>
                    <ContentControl x:Name="RunHistoryHost" Visibility="Collapsed"/>
                    <ContentControl x:Name="ResourceHost" Visibility="Collapsed"/>
                    <Grid x:Name="PlaceholderView" Visibility="Collapsed">
                        <StackPanel Margin="28,22,28,0">
                            <TextBlock Text="{Binding CurrentPage}" FontSize="17" FontWeight="SemiBold"/>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,15,0,0"/>
                        </StackPanel>
                    </Grid>
                    <ContentControl x:Name="SequenceHost" Visibility="Collapsed"/>
                    <ContentControl x:Name="SettingsHost" Visibility="Collapsed"/>
                    <ContentControl x:Name="ControlPreviewHost" Visibility="Collapsed"/>
                    <ContentControl x:Name="ProtocolHost" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Grid>
        <StatusBar Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate><DockPanel LastChildFill="True"/></ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <!-- Station summary: DataContext is StationStatusViewModel (set in code). Hidden when not registered. -->
            <StatusBarItem x:Name="StationStatusPanel" DockPanel.Dock="Left" Padding="4,0,14,0" AutomationProperties.AutomationId="StationDevices">
                <StackPanel Orientation="Horizontal" ToolTip="{x:Static text:UiText.StatusDevicesTooltip}">
                    <StackPanel.Style>
                        <!-- No configured devices (or no project): show nothing rather than "0 / 0". -->
                        <Style TargetType="StackPanel">
                            <Style.Triggers><DataTrigger Binding="{Binding HasDevices}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource StatusOnlineBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConnectedDevices}" Value="0"><Setter Property="Fill" Value="{DynamicResource StatusIdleBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding HasFaults}" Value="True"><Setter Property="Fill" Value="{DynamicResource StatusFaultBrush}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding DevicesText}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </StatusBarItem>
            <!-- "输出中 n 台": only when a connected device reports its output on. Click opens the device page. -->
            <StatusBarItem x:Name="LiveOutputsItem" DockPanel.Dock="Right" Padding="4,0" AutomationProperties.AutomationId="LiveOutputs">
                <Button Click="LiveOutputs_Click" Padding="10,0" MinHeight="20" Height="20" BorderThickness="0" Cursor="Hand"
                        Background="{DynamicResource LiveSurfaceBrush}" ToolTip="{x:Static text:UiText.StatusLiveTooltip}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLiveOutputs}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource LiveSurfaceBrush}"/></Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="LightningBolt" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource LiveBrush}"/>
                        <TextBlock Text="{Binding LiveText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource LiveTextBrush}"/>
                    </StackPanel>
                </Button>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Left" Padding="4,0,14,0" AutomationProperties.AutomationId="ExecutorState">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static text:UiText.StatusExecutor}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="{Binding ExecutionState, Converter={StaticResource UiValue}, ConverterParameter=State}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem Padding="4,0">
                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
    </Border>
    </kit:DialogHost>
</Window>
