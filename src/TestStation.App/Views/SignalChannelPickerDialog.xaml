<Window x:Class="TestStation.App.Views.SignalChannelPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量选择通道" Width="680" Height="520" MinWidth="540" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="勾选要添加的通道，每个通道生成一行" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="SearchInput" TextChanged="SearchChanged" ToolTip="按通道名、来源或数据类型搜索"/>
        </DockPanel>
        <DataGrid Grid.Row="2" x:Name="ChannelGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" CanUserResizeColumns="True" CanUserReorderColumns="False"
                  RowHeight="34" ColumnHeaderHeight="30" HeadersVisibility="Column" RowHeaderWidth="0"
                  SelectionMode="Single" EnableRowVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="选择" Width="60" MinWidth="60" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="通道" Binding="{Binding Definition.Id}" Width="*" MinWidth="190" IsReadOnly="True" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
                <DataGridTextColumn Header="数据类型" Binding="{Binding Definition.DataType, Converter={StaticResource UiValue}}" Width="110" MinWidth="100" IsReadOnly="True" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
                <DataGridTextColumn Header="来源" Binding="{Binding Definition.Source}" Width="120" MinWidth="100" IsReadOnly="True" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="80" MinWidth="70" IsReadOnly="True" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="勾选搜索结果" Click="SelectVisible" Margin="0,0,8,0"/>
                <Button Content="清空勾选" Click="ClearSelection"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="取消" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="添加所选通道" IsDefault="True" Click="ConfirmSelection"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
