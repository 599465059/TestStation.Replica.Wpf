<UserControl x:Class="TestStation.App.Views.Protocols.ProtocolEditorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:text="clr-namespace:TestStation.App.Localization"
 xmlns:vm="clr-namespace:TestStation.App.ViewModels.Protocols" xmlns:local="clr-namespace:TestStation.App.Controls"
 xmlns:kit="clr-namespace:Industrial.Controls;assembly=Industrial.Controls" xmlns:hc="https://handyorg.github.io/handycontrol"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:converters="clr-namespace:TestStation.App.Converters"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <UserControl.Resources>
  <converters:ResourceBrushConverter x:Key="ResourceBrush"/>
  <Style x:Key="PropertyLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Margin" Value="0,12,0,5"/></Style>
 </UserControl.Resources>
 <Grid Margin="18,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12">
   <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
    <Button Content="{x:Static text:UiText.Checksum}" Command="{Binding ValidateProtocolCommand}" Margin="4,0"/>
    <Button Content="{x:Static text:UiText.NewProtocol}" Click="NewProtocol_Click" Margin="4,0"/>
    <Button Content="{x:Static text:UiText.DeleteProtocol}" Click="DeleteProtocol_Click" Margin="4,0"/>
   </StackPanel>
   <TextBlock Text="{x:Static text:UiText.ProtocolEditor}" FontSize="19" FontWeight="SemiBold"/>
  </DockPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,12">
   <TextBlock Text="{x:Static text:UiText.Protocol}" Margin="0,0,8,0"/>
   <ComboBox Width="190" ItemsSource="{Binding Catalog.Protocols}" SelectedItem="{Binding Catalog.SelectedProtocol,Mode=TwoWay}" DisplayMemberPath="Name" AutomationProperties.AutomationId="ProtocolPicker"/>
   <Button Content="{x:Static text:UiText.AddFrame}" Command="{Binding NewFrameCommand}" Margin="12,0,4,0" AutomationProperties.AutomationId="ProtocolFrameNew"/>
   <Button Content="{x:Static text:UiText.CopyFrame}" Command="{Binding CopyFrameCommand}" Margin="4,0"/>
   <Button Content="{x:Static text:UiText.DeleteFrame}" Command="{Binding DeleteFrameCommand}" Margin="4,0"/>
   <Button Content="{x:Static text:UiText.FillReserved}" Command="{Binding FillReservedGapsCommand}" Margin="4,0" ToolTip="{x:Static text:UiText.FillReservedHint}" AutomationProperties.AutomationId="ProtocolFillReserved"/>
   <TextBlock Text="{x:Static text:UiText.ByteWidth}" Margin="16,0,6,0"/>
   <hc:NumericUpDown Width="75" Minimum="36" Maximum="160" Value="{Binding ByteWidth,Mode=TwoWay}"/>
   <TextBlock Text="{x:Static text:UiText.DisplayBytes}" Margin="12,0,6,0"/>
   <hc:NumericUpDown Width="80" Minimum="0" Maximum="4096" Value="{Binding DisplayBytes,Mode=TwoWay}"/>
   <TextBlock Text="{x:Static text:UiText.AutoFitBytes}" Foreground="{DynamicResource MutedBrush}" Margin="8,0"/>
  </WrapPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="180" MinWidth="150"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*" MinWidth="240"/><ColumnDefinition Width="9"/><ColumnDefinition Width="340" MinWidth="300"/></Grid.ColumnDefinitions>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="2*" MinHeight="120"/><RowDefinition Height="8"/><RowDefinition Height="3*" MinHeight="170"/></Grid.RowDefinitions>
    <TreeView x:Name="FrameTree" ItemsSource="{Binding TreeRoots}" SelectedItemChanged="Tree_SelectedItemChanged" AutomationProperties.AutomationId="ProtocolFrameTree">
     <TreeView.Resources>
      <HierarchicalDataTemplate DataType="{x:Type vm:ProtocolTreeRoot}" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Name}"/></HierarchicalDataTemplate>
      <DataTemplate DataType="{x:Type vm:ProtocolTreeEntry}"><TextBlock Text="{Binding Name}"/></DataTemplate>
     </TreeView.Resources>
    </TreeView>
    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource BorderBrush}"/>
    <DockPanel Grid.Row="2">
     <TextBlock DockPanel.Dock="Top" Text="{x:Static text:UiText.FieldPalette}" Foreground="{DynamicResource MutedBrush}" Margin="4,4,0,10"/>
     <ListBox x:Name="FieldPalette" ItemsSource="{Binding Roles}" PreviewMouseLeftButtonDown="Palette_MouseDown" PreviewMouseMove="Palette_MouseMove" MouseDoubleClick="Palette_DoubleClick" AutomationProperties.AutomationId="ProtocolFieldPalette">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><md:PackIcon Kind="{Binding Icon}" Width="17" Height="17" Foreground="{Binding BrushKey,Converter={StaticResource ResourceBrush}}" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Grid>
   <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="{DynamicResource BorderBrush}"/>
   <ScrollViewer Grid.Column="2" x:Name="FramesScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Background="{DynamicResource ContentBrush}">
    <ItemsControl x:Name="FramesOverview" ItemsSource="{Binding VisibleFrames}">
     <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="8,8,8,12">
      <DockPanel Margin="0,0,0,8"><TextBlock DockPanel.Dock="Right" Text="{Binding CalculatedLength,StringFormat='{}{0} B'}" Foreground="{DynamicResource MutedBrush}" Margin="12,0"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Kind,Converter={StaticResource UiValue}}" Foreground="{DynamicResource MutedBrush}" Margin="12,0"/></DockPanel>
      <local:ProtocolFrameCanvas Frame="{Binding Frame}" ByteWidth="{Binding DataContext.ByteWidth,RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayBytes="{Binding DataContext.DisplayBytes,RelativeSource={RelativeSource AncestorType=UserControl}}"
       ViewportWidth="{Binding ViewportWidth,RelativeSource={RelativeSource AncestorType=ScrollViewer}}" ViewportOffset="{Binding HorizontalOffset,RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
       SelectedFieldId="{Binding DataContext.SelectedField.Id,RelativeSource={RelativeSource AncestorType=UserControl}}"
       SelectedFrameId="{Binding DataContext.SelectedFrame.Id,RelativeSource={RelativeSource AncestorType=UserControl}}"
       ByteSelected="Canvas_Selected" FieldDropped="Canvas_FieldDropped" FieldMoved="Canvas_FieldMoved" Loaded="Canvas_Loaded" AutomationProperties.AutomationId="ProtocolFrameCanvas"/>
     </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
   <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" Background="{DynamicResource BorderBrush}"/>
   <kit:NavigationTabs Grid.Column="4" x:Name="PropertyTabs" IsEnabled="{Binding HasProtocol}" Presentation="Pivot" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
    <kit:NavigationTabItem Header="{x:Static text:UiText.ProtocolAndFrame}">
     <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><StackPanel MinWidth="275" Margin="12">
      <TextBlock Text="{x:Static text:UiText.Protocol}" FontWeight="SemiBold"/>
      <TextBlock Text="{x:Static text:UiText.Name}" Style="{StaticResource PropertyLabel}"/><TextBox Text="{Binding ProtocolName,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ProtocolName"/>
      <TextBlock Text="{x:Static text:UiText.Identifier}" Style="{StaticResource PropertyLabel}"/><TextBox Text="{Binding ProtocolId,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="{x:Static text:UiText.Version}" Style="{StaticResource PropertyLabel}"/><TextBox Text="{Binding ProtocolVersion,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="{x:Static text:UiText.Transport}" Style="{StaticResource PropertyLabel}"/><TextBox Text="{Binding Transport,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="{x:Static text:UiText.Description}" Style="{StaticResource PropertyLabel}"/><TextBox Text="{Binding ProtocolDescription,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="{x:Static text:UiText.CurrentFrame}" FontWeight="SemiBold" Margin="0,24,0,0"/>
      <TextBlock Text="{x:Static text:UiText.Name}" Style="{StaticResource PropertyLabel}"/><TextBox Text="{Binding FrameForm.Name,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ProtocolFrameName"/>
      <TextBlock Text="{x:Static text:UiText.Identifier}" Style="{StaticResource PropertyLabel}"/><TextBox Text="{Binding FrameForm.Id,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="{x:Static text:UiText.Type}" Style="{StaticResource PropertyLabel}"/><ComboBox ItemsSource="{Binding FrameKinds}" ItemTemplate="{StaticResource UiOptionTemplate}" SelectedItem="{Binding FrameForm.Kind,Mode=TwoWay}"/>
      <TextBlock Text="{x:Static text:UiText.FixedLength}" Style="{StaticResource PropertyLabel}"/><TextBox Text="{Binding FrameForm.FixedLength,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="{x:Static text:UiText.LengthFieldId}" Style="{StaticResource PropertyLabel}"/><TextBox Text="{Binding FrameForm.LengthFieldId,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="{x:Static text:UiText.ChecksumConfiguration}" Style="{StaticResource PropertyLabel}"/><ComboBox ItemsSource="{Binding Checksums}" ItemTemplate="{StaticResource UiOptionTemplate}" SelectedItem="{Binding FrameForm.ChecksumAlgorithm,Mode=TwoWay}"/>
      <TextBlock Text="{x:Static text:UiText.ChecksumStart}" Style="{StaticResource PropertyLabel}"/><TextBox Text="{Binding FrameForm.ChecksumStart,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="{x:Static text:UiText.FrameDescription}" Style="{StaticResource PropertyLabel}"/><TextBox Text="{Binding FrameForm.Description,UpdateSourceTrigger=PropertyChanged}"/>
      <Button Content="{x:Static text:UiText.ApplyProperties}" Command="{Binding ApplyPropertiesCommand}" Margin="0,16,0,6"/>
     </StackPanel></ScrollViewer>
    </kit:NavigationTabItem>
    <kit:NavigationTabItem Header="{x:Static text:UiText.Field}">
     <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><StackPanel MinWidth="275" Margin="12">
      <TextBlock Text="{x:Static text:UiText.EditSelectedFieldHint}" Foreground="{DynamicResource MutedBrush}"/>
      <TextBlock Text="{x:Static text:UiText.Name}" Style="{StaticResource PropertyLabel}"/><TextBox Text="{Binding FieldForm.Name,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ProtocolFieldName"/>
      <TextBlock Text="{x:Static text:UiText.Identifier}" Style="{StaticResource PropertyLabel}"/><TextBox Text="{Binding FieldForm.Id,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="{x:Static text:UiText.Role}" Style="{StaticResource PropertyLabel}"/><ComboBox ItemsSource="{Binding FieldRoles}" ItemTemplate="{StaticResource UiOptionTemplate}" SelectedItem="{Binding FieldForm.Role,Mode=TwoWay}"/>
      <TextBlock Text="{x:Static text:UiText.DataType}" Style="{StaticResource PropertyLabel}"/><ComboBox ItemsSource="{Binding FieldTypes}" ItemTemplate="{StaticResource UiOptionTemplate}" SelectedItem="{Binding FieldForm.DataType,Mode=TwoWay}"/>
      <TextBlock Text="{x:Static text:UiText.StartByte}" Style="{StaticResource PropertyLabel}"/><TextBox Text="{Binding FieldForm.ByteOffset,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="{x:Static text:UiText.ByteLength}" Style="{StaticResource PropertyLabel}"/><TextBox Text="{Binding FieldForm.Length,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="{x:Static text:UiText.ByteOrder}" Style="{StaticResource PropertyLabel}"/><ComboBox ItemsSource="{Binding ByteOrders}" ItemTemplate="{StaticResource UiOptionTemplate}" SelectedItem="{Binding FieldForm.ByteOrder,Mode=TwoWay}"/>
      <TextBlock Text="{x:Static text:UiText.Scale}" Style="{StaticResource PropertyLabel}"/><TextBox Text="{Binding FieldForm.Scale,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="{x:Static text:UiText.Offset}" Style="{StaticResource PropertyLabel}"/><TextBox Text="{Binding FieldForm.ValueOffset,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="{x:Static text:UiText.Constant}" Style="{StaticResource PropertyLabel}"/><TextBox Text="{Binding FieldForm.Constant,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="{x:Static text:UiText.ChannelReference}" Style="{StaticResource PropertyLabel}"/><TextBox Text="{Binding FieldForm.ChannelId,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="{x:Static text:UiText.Description}" Style="{StaticResource PropertyLabel}"/><TextBox Text="{Binding FieldForm.Description,UpdateSourceTrigger=PropertyChanged}"/>
      <CheckBox Content="{x:Static text:UiText.EnableField}" IsChecked="{Binding FieldForm.Enabled}" Margin="0,14,0,0"/>
      <Button Content="{x:Static text:UiText.ApplyProperties}" Command="{Binding ApplyPropertiesCommand}" Margin="0,16,0,6" AutomationProperties.AutomationId="ProtocolApplyField"/>
      <Button Content="{x:Static text:UiText.DeleteField}" Command="{Binding DeleteFieldCommand}"/>
     </StackPanel></ScrollViewer>
    </kit:NavigationTabItem>
    <kit:NavigationTabItem Header="{x:Static text:UiText.Preview}">
     <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><StackPanel MinWidth="275" Margin="12">
      <TextBlock Text="{x:Static text:UiText.HexFrame}" Style="{StaticResource PropertyLabel}"/>
      <TextBox Text="{Binding HexInput,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="80"/>
      <Button Content="{x:Static text:UiText.GenerateFrame}" Command="{Binding GeneratePreviewCommand}" Margin="0,12,0,6"/>
      <Button Content="{x:Static text:UiText.ParseInput}" Command="{Binding ParsePreviewCommand}"/>
      <TextBox Text="{Binding PreviewOutput,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" MinHeight="220" TextWrapping="Wrap" Margin="0,16,0,0"/>
     </StackPanel></ScrollViewer>
    </kit:NavigationTabItem>
   </kit:NavigationTabs>
  </Grid>
  <DockPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding IsDirty,Converter={StaticResource UiValue},ConverterParameter=Dirty}" Foreground="{DynamicResource MutedBrush}" Margin="12,0"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></DockPanel>
 </Grid>
</UserControl>
