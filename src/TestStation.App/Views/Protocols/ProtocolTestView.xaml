<UserControl x:Class="TestStation.App.Views.Protocols.ProtocolTestView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:text="clr-namespace:TestStation.App.Localization"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="22,18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{x:Static text:UiText.OfflineProtocolTest}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"/>
  <Grid Grid.Row="1" Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="200"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget,Mode=TwoWay}" DisplayMemberPath="Name" AutomationProperties.AutomationId="ProtocolTestTarget"/>
   <Button Grid.Column="1" Content="{x:Static text:UiText.GenerateFrame}" Command="{Binding GenerateCommand}" Margin="12,0,6,0" AutomationProperties.AutomationId="ProtocolTestGenerate"/>
   <Button Grid.Column="2" Content="{x:Static text:UiText.ParseInput}" Command="{Binding ParseCommand}" AutomationProperties.AutomationId="ProtocolTestParse"/>
  </Grid>
  <Grid Grid.Row="2" Margin="0,0,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="230"/><ColumnDefinition Width="16"/><ColumnDefinition Width="2*" MinWidth="220"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="{x:Static text:UiText.HexFrame}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding HexInput,UpdateSourceTrigger=PropertyChanged}" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.AutomationId="ProtocolTestHex"/></StackPanel>
   <StackPanel Grid.Column="2"><TextBlock Text="{x:Static text:UiText.DbcSignalJson}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding SignalValues,UpdateSourceTrigger=PropertyChanged}" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap"/></StackPanel>
  </Grid>
  <DataGrid Grid.Row="3" x:Name="ResultsGrid" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0">
   <DataGrid.Columns>
    <DataGridTextColumn Header="{x:Static text:UiText.FieldOrSignal}" Binding="{Binding Name}" Width="180" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
    <DataGridTextColumn Header="{x:Static text:UiText.StartOffset}" Binding="{Binding Offset}" Width="75" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
    <DataGridTextColumn Header="{x:Static text:UiText.Length}" Binding="{Binding Length}" Width="75" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
    <DataGridTextColumn Header="{x:Static text:UiText.TypeOrUnit}" Binding="{Binding Type,Converter={StaticResource UiValue}}" Width="130" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
    <DataGridTextColumn Header="{x:Static text:UiText.RawHexValue}" Binding="{Binding Hex}" Width="180" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
    <DataGridTextColumn Header="{x:Static text:UiText.StateOrPhysical}" Binding="{Binding State}" Width="*" MinWidth="160" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock Grid.Row="4" Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
 </Grid>
</UserControl>
