<UserControl x:Class="TestStation.App.Views.Protocols.ProtocolLibraryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:text="clr-namespace:TestStation.App.Localization"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="22,18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button Content="{x:Static text:UiText.New}" Click="New_Click" Margin="4,0" AutomationProperties.AutomationId="ProtocolNew"/>
    <Button Content="{x:Static text:UiText.Import}" Click="Import_Click" Margin="4,0"/>
    <Button Content="{x:Static text:UiText.Export}" Click="Export_Click" Margin="4,0"/>
    <Button Content="{x:Static text:UiText.Delete}" Click="Delete_Click" Margin="4,0" AutomationProperties.AutomationId="ProtocolDelete"/>
   </StackPanel>
   <TextBlock Text="{x:Static text:UiText.ProtocolLibrary}" FontSize="19" FontWeight="SemiBold"/>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="260"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*" MinWidth="320"/></Grid.ColumnDefinitions>
   <DataGrid x:Name="ProtocolList" ItemsSource="{Binding Protocols}" SelectedItem="{Binding SelectedProtocol,Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" RowHeaderWidth="0" CanUserAddRows="False">
    <DataGrid.Columns>
     <DataGridTextColumn Header="{x:Static text:UiText.Name}" Binding="{Binding Name}" Width="*" MinWidth="130" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
     <DataGridTextColumn Header="{x:Static text:UiText.Version}" Binding="{Binding Version}" Width="70" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
     <DataGridTextColumn Header="{x:Static text:UiText.FrameCount}" Binding="{Binding Frames.Count}" Width="60" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
    </DataGrid.Columns>
   </DataGrid>
   <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="{DynamicResource BorderBrush}"/>
   <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <StackPanel MinWidth="290" Margin="18,8">
     <TextBlock Text="{Binding SelectedProtocol.Name,TargetNullValue='当前没有协议'}" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding SelectedProtocol.Id}" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
     <TextBlock Text="{Binding SelectedProtocol.Transport,Converter={StaticResource UiValue},StringFormat='通信类型：{0}'}" Margin="0,14,0,0"/>
     <TextBlock Text="{Binding SelectedProtocol.Version,StringFormat='版本：{0}'}" Margin="0,8,0,0"/>
     <TextBlock Text="{Binding SelectedProtocol.Frames.Count,StringFormat='帧数：{0}'}" Margin="0,8,0,0"/>
     <TextBlock Text="{Binding SelectedProtocol.Description}" TextWrapping="Wrap" Margin="0,14,0,0"/>
     <ItemsControl ItemsSource="{Binding SelectedProtocol.Frames}" Margin="0,20,0,0">
      <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Kind,Converter={StaticResource UiValue}}" Foreground="{DynamicResource MutedBrush}" Margin="16,0,0,0"/><TextBlock Text="{Binding Name}"/></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
 </Grid>
</UserControl>
