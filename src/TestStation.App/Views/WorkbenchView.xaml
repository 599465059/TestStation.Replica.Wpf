<UserControl x:Class="TestStation.App.Views.WorkbenchView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:text="clr-namespace:TestStation.App.Localization"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" AutomationProperties.AutomationId="WorkbenchView">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <!-- Section container: layout only (Border), colors from theme tokens. -->
  <Style x:Key="WorkbenchCard" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style x:Key="CardTitle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <!-- Text-only link action in a card header. Reuses the project button style; only colors and chrome change. -->
  <Style x:Key="CardLinkButton" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Padding" Value="8,3"/><Setter Property="MinHeight" Value="26"/>
  </Style>
  <!-- Clickable device card. Same AppButtonStyle template; card surface and stretch only. -->
  <Style x:Key="DeviceCardButton" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
   <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Top"/>
   <Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,0,12,12"/><Setter Property="Width" Value="270"/>
   <Style.Triggers>
    <!-- Energized output: the one persistent orange cue on the page. -->
    <DataTrigger Binding="{Binding Kind}" Value="live"><Setter Property="BorderBrush" Value="{DynamicResource LiveBrush}"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <!-- Status pill: dot + text; Kind = online / idle / fault / missing. -->
  <Style x:Key="StatePill" TargetType="Border">
   <Setter Property="CornerRadius" Value="11"/><Setter Property="Padding" Value="8,2"/><Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="live"><Setter Property="Background" Value="{DynamicResource LiveSurfaceBrush}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="StateDot" TargetType="Ellipse">
   <Setter Property="Width" Value="7"/><Setter Property="Height" Value="7"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Fill" Value="{DynamicResource StatusIdleBrush}"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Kind}" Value="online"><Setter Property="Fill" Value="{DynamicResource StatusOnlineBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding Kind}" Value="fault"><Setter Property="Fill" Value="{DynamicResource StatusFaultBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding Kind}" Value="live"><Setter Property="Fill" Value="{DynamicResource LiveBrush}"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="StateText" TargetType="TextBlock">
   <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Kind}" Value="online"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding Kind}" Value="fault"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding Kind}" Value="live"><Setter Property="Foreground" Value="{DynamicResource LiveTextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="RunResult" TargetType="TextBlock">
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Kind}" Value="success"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding Kind}" Value="error"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="KeyText" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Margin" Value="0,3"/></Style>
  <Style x:Key="ValueText" TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="Margin" Value="12,3,0,3"/></Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="20,16,20,24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <!-- Page header: title, one-line purpose, actions. -->
   <DockPanel Margin="0,0,0,14">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Command="{Binding OpenManualTestCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="WorkbenchManual">
      <StackPanel Orientation="Horizontal"><md:PackIcon Kind="TuneVariant" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{x:Static text:UiText.ManualTest}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel>
     </Button>
     <Button Command="{Binding OpenAutomaticTestCommand}" Style="{DynamicResource AccentButton}" AutomationProperties.AutomationId="WorkbenchAutomatic">
      <StackPanel Orientation="Horizontal"><md:PackIcon Kind="PlayCircleOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{x:Static text:UiText.WorkbenchOpenAutomatic}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel>
     </Button>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="{x:Static text:UiText.Workbench}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <TextBlock Text="{x:Static text:UiText.WorkbenchSubtitle}" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
   </DockPanel>

   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="320"/><ColumnDefinition Width="16"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>

    <!-- Devices: the main content of this page. -->
    <Border Style="{StaticResource WorkbenchCard}" VerticalAlignment="Top">
     <DockPanel>
      <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,0,1" Padding="14,8">
       <DockPanel>
        <Button DockPanel.Dock="Right" Content="{x:Static text:UiText.WorkbenchManageResources}" Command="{Binding OpenHardwareCommand}" Style="{StaticResource CardLinkButton}"/>
        <StackPanel Orientation="Horizontal">
         <TextBlock Text="{x:Static text:UiText.Devices}" Style="{StaticResource CardTitle}"/>
         <TextBlock Text="{x:Static text:UiText.WorkbenchDevicesHint}" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
       </DockPanel>
      </Border>
      <Grid Margin="14,12,2,0">
       <ItemsControl ItemsSource="{Binding Devices}" AutomationProperties.AutomationId="WorkbenchDevices">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <Button Style="{StaticResource DeviceCardButton}" ToolTip="{Binding Detail}"
                  Command="{Binding DataContext.OpenDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
           <StackPanel>
            <DockPanel>
             <Border DockPanel.Dock="Right" Style="{StaticResource StatePill}">
              <StackPanel Orientation="Horizontal"><Ellipse Style="{StaticResource StateDot}"/><TextBlock Text="{Binding StateText}" Style="{StaticResource StateText}"/></StackPanel>
             </Border>
             <md:PackIcon Kind="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
             <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}"/>
            </DockPanel>
            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="26,4,0,0" TextTrimming="CharacterEllipsis"/>
           </StackPanel>
          </Button>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
       <StackPanel Margin="0,4,12,16">
        <StackPanel.Style>
         <Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding HasDevices}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
        </StackPanel.Style>
        <TextBlock Text="{x:Static text:UiText.WorkbenchNoDevices}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
        <Button Content="{x:Static text:UiText.HardwareConfig}" Command="{Binding OpenHardwareCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
       </StackPanel>
      </Grid>
     </DockPanel>
    </Border>

    <StackPanel Grid.Column="2">
     <!-- Recent runs -->
     <Border Style="{StaticResource WorkbenchCard}" Margin="0,0,0,12">
      <DockPanel>
       <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,0,1" Padding="14,8">
        <DockPanel>
         <Button DockPanel.Dock="Right" Content="{x:Static text:UiText.WorkbenchAll}" Command="{Binding OpenRunHistoryCommand}" Style="{StaticResource CardLinkButton}"/>
         <TextBlock Text="{x:Static text:UiText.WorkbenchRecentRuns}" Style="{StaticResource CardTitle}"/>
        </DockPanel>
       </Border>
       <Grid>
        <ItemsControl ItemsSource="{Binding RecentRuns}" AutomationProperties.AutomationId="WorkbenchRuns">
         <ItemsControl.ItemTemplate>
          <DataTemplate>
           <Border BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
             <TextBlock DockPanel.Dock="Right" Text="{Binding ResultText}" Style="{StaticResource RunResult}" Margin="10,0,0,0"/>
             <StackPanel>
              <TextBlock Text="{Binding SequenceName}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding When}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
             </StackPanel>
            </DockPanel>
           </Border>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{x:Static text:UiText.WorkbenchNoRuns}" Foreground="{DynamicResource MutedBrush}" Margin="14,12" TextWrapping="Wrap">
         <TextBlock.Style>
          <Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasRuns}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
         </TextBlock.Style>
        </TextBlock>
       </Grid>
      </DockPanel>
     </Border>

     <!-- Project summary -->
     <Border Style="{StaticResource WorkbenchCard}" Margin="0,0,0,12">
      <DockPanel>
       <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,0,1" Padding="14,10">
        <TextBlock Text="{x:Static text:UiText.WorkbenchProject}" Style="{StaticResource CardTitle}"/>
       </Border>
       <Grid Margin="14,8,14,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="{x:Static text:UiText.WorkbenchProjectName}" Style="{StaticResource KeyText}"/>
        <TextBlock Grid.Column="1" Text="{Binding ProjectName}" Style="{StaticResource ValueText}" ToolTip="{Binding ProjectPath}"/>
        <TextBlock Grid.Row="1" Text="{x:Static text:UiText.WorkbenchMainSequence}" Style="{StaticResource KeyText}"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MainSequences}" Style="{StaticResource ValueText}" ToolTip="{Binding MainSequences}"/>
        <TextBlock Grid.Row="2" Text="{x:Static text:UiText.WorkbenchSubprojects}" Style="{StaticResource KeyText}"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SubprojectCount}" Style="{StaticResource ValueText}"/>
        <TextBlock Grid.Row="3" Text="{x:Static text:UiText.WorkbenchSequences}" Style="{StaticResource KeyText}"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SequenceCount}" Style="{StaticResource ValueText}"/>
        <TextBlock Grid.Row="4" Text="{x:Static text:UiText.HwInstances}" Style="{StaticResource KeyText}"/>
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DeviceCount}" Style="{StaticResource ValueText}"/>
        <TextBlock Grid.Row="5" Text="{x:Static text:UiText.HwResources}" Style="{StaticResource KeyText}"/>
        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ResourceCount}" Style="{StaticResource ValueText}"/>
       </Grid>
      </DockPanel>
     </Border>

     <!-- Plugins -->
     <Border Style="{StaticResource WorkbenchCard}">
      <DockPanel>
       <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,0,1" Padding="14,8">
        <DockPanel>
         <Button DockPanel.Dock="Right" Content="{x:Static text:UiText.WorkbenchManage}" Command="{Binding OpenPluginsCommand}" Style="{StaticResource CardLinkButton}"/>
         <TextBlock Text="{x:Static text:UiText.PluginManagement}" Style="{StaticResource CardTitle}"/>
        </DockPanel>
       </Border>
       <StackPanel Margin="14,10">
        <TextBlock Text="{Binding PluginSummary}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
        <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0">
         <TextBlock.Style>
          <Style TargetType="TextBlock">
           <Setter Property="Visibility" Value="Collapsed"/>
           <Style.Triggers><DataTrigger Binding="{Binding HasMissingPlugins}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style>
         </TextBlock.Style>
         <Run Text="{x:Static text:UiText.WorkbenchMissingPlugins}"/><Run Text="{Binding MissingPlugins, Mode=OneWay}"/>
        </TextBlock>
       </StackPanel>
      </DockPanel>
     </Border>
    </StackPanel>
   </Grid>
  </Grid>
 </ScrollViewer>
</UserControl>
