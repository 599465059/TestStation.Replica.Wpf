<UserControl x:Class="TestStation.App.Views.RunHistoryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:text="clr-namespace:TestStation.App.Localization"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" AutomationProperties.AutomationId="RunHistoryView">
 <UserControl.Resources>
  <!-- Result colour from the stored status id; text from UiDisplay.State. -->
  <Style x:Key="RunStatusText" TargetType="TextBlock">
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Status}" Value="completed"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding Status}" Value="failed"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="EmptyHint" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="TextAlignment" Value="Center"/><Setter Property="Margin" Value="20"/><Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
 </UserControl.Resources>
 <Grid Margin="20,16,20,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <!-- Page header. Right-side buttons are docked first so LastChildFill applies to the title, not a button. -->
  <DockPanel Margin="0,0,0,14">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Command="{Binding RefreshCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="RefreshRunHistory">
     <StackPanel Orientation="Horizontal"><md:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{x:Static text:UiText.Refresh}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel>
    </Button>
    <Button Command="{Binding OpenReportCommand}" Style="{DynamicResource AccentButton}" AutomationProperties.AutomationId="OpenRunReport">
     <StackPanel Orientation="Horizontal"><md:PackIcon Kind="FileDocumentOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{x:Static text:UiText.RunHistoryOpenReport}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel>
    </Button>
   </StackPanel>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="{x:Static text:UiText.RunHistory}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock Text="{x:Static text:UiText.RunHistorySubtitle}" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
  </DockPanel>

  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="280" MinWidth="230"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*" MinWidth="560"/></Grid.ColumnDefinitions>
   <!-- Run list -->
   <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
    <Grid>
     <ListBox x:Name="ReportsList" ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" BorderThickness="0" Background="Transparent"
              Margin="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="RunReports">
      <ListBox.ItemTemplate>
       <DataTemplate>
        <StackPanel Margin="8,6">
         <TextBlock Text="{Binding SequenceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
         <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
          <TextBlock Text="{Binding Status, Converter={StaticResource UiValue}, ConverterParameter=State}" Style="{StaticResource RunStatusText}" FontSize="12"/>
          <TextBlock Text="{Binding StartedAt, StringFormat='MM-dd HH:mm'}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="10,0,0,0"/>
         </StackPanel>
        </StackPanel>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
     <TextBlock Text="{x:Static text:UiText.RunHistoryEmpty}">
      <TextBlock.Style>
       <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHint}">
        <Style.Triggers><DataTrigger Binding="{Binding HasReports}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>
    </Grid>
   </Border>

   <!-- Selected run -->
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
     <TextBlock Text="{Binding Details}" TextWrapping="Wrap" LineHeight="22"/>
    </Border>
    <Border Grid.Row="1" Margin="0,12,0,0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
     <Grid>
      <DataGrid ItemsSource="{Binding Steps}" Style="{StaticResource AppDataGridStyle}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                HeadersVisibility="Column" RowHeaderWidth="0" ColumnHeaderHeight="32" RowHeight="30" CanUserResizeColumns="True" BorderThickness="0"
                Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.AutomationId="RunSteps">
       <DataGrid.Columns>
        <DataGridTextColumn Header="{x:Static text:UiText.RunHistorySection}" Binding="{Binding Section, Converter={StaticResource UiValue}, ConverterParameter=Section}" Width="90" MinWidth="80" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
        <DataGridTextColumn Header="{x:Static text:UiText.Step}" Binding="{Binding Name}" Width="*" MinWidth="180" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
        <DataGridTextColumn Header="{x:Static text:UiText.Status}" Binding="{Binding Status, Converter={StaticResource UiValue}, ConverterParameter=State}" Width="90" MinWidth="80" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
        <DataGridTextColumn Header="{x:Static text:UiText.RunHistoryDuration}" Binding="{Binding DurationMs, StringFormat={}{0} ms}" Width="100" MinWidth="90" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
        <DataGridTextColumn Header="{x:Static text:UiText.Message}" Binding="{Binding Message}" Width="2*" MinWidth="200" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
       </DataGrid.Columns>
      </DataGrid>
      <TextBlock Margin="20,48,20,20">
       <TextBlock.Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHint}">
         <Setter Property="Text" Value="{x:Static text:UiText.RunHistoryNoSteps}"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding HasSelection}" Value="False"><Setter Property="Text" Value="{x:Static text:UiText.RunHistorySelectHint}"/></DataTrigger>
          <DataTrigger Binding="{Binding HasSteps}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
         </Style.Triggers>
        </Style>
       </TextBlock.Style>
      </TextBlock>
     </Grid>
    </Border>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
