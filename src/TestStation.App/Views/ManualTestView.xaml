<UserControl x:Class="TestStation.App.Views.ManualTestView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:kit="clr-namespace:Industrial.Controls;assembly=Industrial.Controls"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
 xmlns:text="clr-namespace:TestStation.App.Localization"
 Background="{DynamicResource ContentBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <ToolBar Style="{StaticResource AppToolBarStyle}">
   <Button x:Name="AddPluginButton" Click="AddPlugin_Click">
    <StackPanel Orientation="Horizontal"><md:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="{x:Static text:UiText.ManualAddDevice}"/></StackPanel>
   </Button>
   <Button x:Name="ViewToggleButton" Content="{x:Static text:UiText.ManualWindowView}" Click="ToggleView_Click"/>
   <Button Content="{x:Static text:UiText.ManualTile}" Click="Tile_Click"/>
   <Button Content="{x:Static text:UiText.ManualCascade}" Click="Cascade_Click"/>
  </ToolBar>
  <kit:MdiWorkspace x:Name="Workspace" Grid.Row="1" View="Tabbed"
   Background="{DynamicResource ContentBrush}" Foreground="{DynamicResource TextBrush}"/>
  <TextBlock x:Name="EmptyPluginState" Grid.Row="1" Text="{x:Static text:UiText.ManualPluginEmptyHint}"
   TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center"
   Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" Visibility="Collapsed"/>
 </Grid>
</UserControl>
