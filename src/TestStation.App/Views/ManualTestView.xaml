<UserControl x:Class="TestStation.App.Views.ManualTestView" x:Name="ManualRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:text="clr-namespace:TestStation.App.Localization"
 Background="{DynamicResource ContentBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <ToolBar Style="{StaticResource AppToolBarStyle}">
   <ComboBox x:Name="GroupSelector" ItemsSource="{Binding Panels.Groups, ElementName=ManualRoot}" SelectedItem="{Binding Panels.ActiveGroup, ElementName=ManualRoot, Mode=TwoWay}" DisplayMemberPath="Name" Width="150" ToolTip="{x:Static text:UiText.ManualGroup}"/>
   <Button x:Name="GroupMenuButton" Content="{x:Static text:UiText.ManualGroupManage}" Click="GroupMenu_Click"/>
   <Separator/>
   <Button x:Name="AddPluginButton" Click="AddPlugin_Click" Content="{x:Static text:UiText.ManualAddDevice}"/>
   <Button x:Name="OpenedPanelsButton" Content="{x:Static text:UiText.ManualOpenedPanels}" Click="OpenedPanels_Click"/>
   <Separator/>
   <Button x:Name="ViewToggleButton" Content="{x:Static text:UiText.ManualWindowView}" Click="ToggleView_Click"/>
   <Button Content="{x:Static text:UiText.ManualTile}" Click="Tile_Click"/>
   <Button Content="{x:Static text:UiText.ManualColumns}" Click="Columns_Click"/>
   <Button Content="{x:Static text:UiText.ManualQuad}" Click="Quad_Click"/>
   <Button Content="{x:Static text:UiText.ManualCascade}" Click="Cascade_Click"/>
  </ToolBar>
  <TextBlock x:Name="PanelStatus" Grid.Row="1" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="8,3" Visibility="Collapsed"/>
  <ContentControl x:Name="WorkspaceHost" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <TextBlock x:Name="EmptyPluginState" Grid.Row="2" Text="{x:Static text:UiText.ManualPluginEmptyHint}" TextWrapping="Wrap" MaxWidth="520" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"/>
  <Popup x:Name="DevicePicker" PlacementTarget="{Binding ElementName=AddPluginButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
   <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}" Padding="12" Width="540" MaxHeight="470">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="{x:Static text:UiText.ManualChooseInstances}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
     <TextBox x:Name="DeviceSearch" Grid.Row="1" TextChanged="DeviceSearch_Changed" ToolTip="{x:Static text:UiText.ManualSearchDevices}" Margin="0,0,0,8"/>
     <ListBox x:Name="DeviceChoices" Grid.Row="2" MinHeight="120" MaxHeight="300" ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
      <ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Picked, Mode=TwoWay}" Content="{Binding Caption}" Margin="2,4"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock x:Name="PickerEmpty" Grid.Row="2" Text="{x:Static text:UiText.ManualNoInstances}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" IsHitTestVisible="False" Visibility="Collapsed"/>
     <DockPanel Grid.Row="3" Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="{x:Static text:UiText.ManualAddSelected}" Click="AddSelected_Click"/><TextBlock Text="{x:Static text:UiText.ManualGroupLimit}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/></DockPanel>
    </Grid>
   </Border>
  </Popup>
 </Grid>
</UserControl>
