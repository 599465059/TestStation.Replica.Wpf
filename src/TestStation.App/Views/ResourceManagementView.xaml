<UserControl x:Class="TestStation.App.Views.ResourceManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="clr-namespace:TestStation.App.Localization"
             Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
             AutomationProperties.AutomationId="ResourceManagementView">
    <Grid Margin="22,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{x:Static text:UiText.CommunicationResource}" Command="{Binding NewTransportCommand}" Margin="4,0"/>
                <Button Content="{x:Static text:UiText.Device}" Command="{Binding NewDeviceCommand}" Margin="4,0"/>
                <Button Content="{x:Static text:UiText.AddChannel}" Command="{Binding NewChannelCommand}" Margin="4,0"/>
                <Button Content="{x:Static text:UiText.Delete}" Command="{Binding DeleteSelectedCommand}" Margin="4,0"/>
                <Button Content="{x:Static text:UiText.Refresh}" Command="{Binding RefreshCommand}" Margin="4,0"/>
            </StackPanel>
            <StackPanel><TextBlock Text="{x:Static text:UiText.ResourceManagement}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{x:Static text:UiText.ResourceSubtitle}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" MinWidth="220"/><ColumnDefinition Width="1.1*" MinWidth="250"/><ColumnDefinition Width="2*" MinWidth="380"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{x:Static text:UiText.CommunicationResource}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Transports}" SelectedItem="{Binding SelectedTransport,Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
                    <DataGrid.Columns><DataGridTextColumn Header="{x:Static text:UiText.Name}" Binding="{Binding Name,UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="100" ElementStyle="{StaticResource AppDataGridTextStyle}"/><DataGridTextColumn Header="{x:Static text:UiText.Type}" Binding="{Binding Type}" Width="90" MinWidth="70" ElementStyle="{StaticResource AppDataGridTextStyle}"/></DataGrid.Columns>
                </DataGrid>
                <Expander Grid.Row="2" Header="通信参数" IsExpanded="True" Margin="0,10,0,0">
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding TransportSettings}" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="190" MinHeight="70" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="参数" Binding="{Binding Label}" IsReadOnly="True" Width="*" MinWidth="90" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
                                <DataGridTextColumn Header="值" Binding="{Binding Value,UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="90" ElementStyle="{StaticResource AppDataGridTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="1" Content="应用通信参数" Command="{Binding ApplyTransportSettingsCommand}" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                    </Grid>
                </Expander>
            </Grid>
            <Grid Grid.Column="1" Margin="8,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{x:Static text:UiText.Device}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice,Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
                    <DataGrid.Columns><DataGridTextColumn Header="{x:Static text:UiText.Name}" Binding="{Binding Name,UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="100" ElementStyle="{StaticResource AppDataGridTextStyle}"/><DataGridTextColumn Header="{x:Static text:UiText.Driver}" Binding="{Binding DriverId}" Width="100" MinWidth="80" ElementStyle="{StaticResource AppDataGridTextStyle}"/><DataGridTextColumn Header="{x:Static text:UiText.ChannelCount}" Binding="{Binding Channels.Count}" Width="70" ElementStyle="{StaticResource AppDataGridTextStyle}"/></DataGrid.Columns>
                </DataGrid>
                <Expander Grid.Row="2" Header="内置驱动" Margin="0,10,0,0" MaxHeight="160">
                    <ListBox ItemsSource="{Binding Drivers}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,3">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Expander>
            </Grid>
            <Grid Grid.Column="2" Margin="8,0,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{x:Static text:UiText.Channel}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel,Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
                    <DataGrid.Columns><DataGridTextColumn Header="{x:Static text:UiText.Name}" Binding="{Binding Name,UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="110" ElementStyle="{StaticResource AppDataGridTextStyle}"/><DataGridTextColumn Header="{x:Static text:UiText.Unit}" Binding="{Binding Unit,UpdateSourceTrigger=PropertyChanged}" Width="75" MinWidth="55" ElementStyle="{StaticResource AppDataGridTextStyle}"/><DataGridTextColumn Header="{x:Static text:UiText.Access}" Binding="{Binding Access,UpdateSourceTrigger=PropertyChanged}" Width="95" MinWidth="80" ElementStyle="{StaticResource AppDataGridTextStyle}"/><DataGridTextColumn Header="{x:Static text:UiText.Polling}" Binding="{Binding Polling.Mode,UpdateSourceTrigger=PropertyChanged}" Width="85" MinWidth="70" ElementStyle="{StaticResource AppDataGridTextStyle}"/><DataGridTextColumn Header="{x:Static text:UiText.PollingPeriod}" Binding="{Binding Polling.IntervalMs,UpdateSourceTrigger=PropertyChanged}" Width="90" MinWidth="80" ElementStyle="{StaticResource AppDataGridTextStyle}"/></DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="2" Background="{DynamicResource SubtleBrush}" Padding="12" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static text:UiText.Device}"/><TextBox Grid.Column="1" Text="{Binding SelectedDevice.Name,UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Column="2" Text="{x:Static text:UiText.CommunicationResource}" Margin="14,0,0,0"/><TextBox Grid.Column="3" Text="{Binding SelectedDevice.TransportId,UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Text="设备家族"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDevice.FamilyId,UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="型号 ID" Margin="14,0,0,0"/><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SelectedDevice.ModelId,UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="2" Text="设备地址"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDevice.ResourceAddress,UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="协议" Margin="14,0,0,0"/><TextBox Grid.Row="2" Grid.Column="3" Text="{Binding SelectedDevice.ProtocolId,UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
    </Grid>
</UserControl>
