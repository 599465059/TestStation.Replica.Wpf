<UserControl x:Class="TestStation.App.Views.DeviceTestingView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:text="clr-namespace:TestStation.App.Localization"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
 Background="{DynamicResource ContentBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220" MinWidth="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <!-- In-page family list. Families come from the plugin registry, so loading or
       unloading a plugin updates this list without rebuilding the shell navigation. -->
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
   <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{x:Static text:UiText.HwFamilies}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="14,12,14,6"/>
    <Grid>
     <ListBox x:Name="FamilyList" AutomationProperties.AutomationId="DeviceFamilyList" BorderThickness="0" Background="Transparent"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single" SelectionChanged="FamilyList_SelectionChanged">
      <ListBox.ItemTemplate>
       <!-- Family rows (Kind=family) with their device instances below (Kind=device, indented, status dot). -->
       <DataTemplate>
        <StackPanel Orientation="Horizontal" Height="30" ToolTip="{Binding Tooltip}">
         <StackPanel.Style>
          <Style TargetType="StackPanel">
           <Setter Property="Margin" Value="22,0,0,0"/>
           <Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="family"><Setter Property="Margin" Value="0"/></DataTrigger></Style.Triggers>
          </Style>
         </StackPanel.Style>
         <md:PackIcon Kind="{Binding Icon}" Width="16" Height="16" Margin="6,0,10,0" VerticalAlignment="Center">
          <md:PackIcon.Style>
           <Style TargetType="md:PackIcon"><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="device"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
          </md:PackIcon.Style>
         </md:PackIcon>
         <Ellipse Width="8" Height="8" Margin="4,0,10,0" VerticalAlignment="Center">
          <Ellipse.Style>
           <Style TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource StatusIdleBrush}"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding Kind}" Value="family"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
             <DataTrigger Binding="{Binding State}" Value="online"><Setter Property="Fill" Value="{DynamicResource StatusOnlineBrush}"/></DataTrigger>
             <DataTrigger Binding="{Binding State}" Value="live"><Setter Property="Fill" Value="{DynamicResource LiveBrush}"/></DataTrigger>
             <DataTrigger Binding="{Binding State}" Value="fault"><Setter Property="Fill" Value="{DynamicResource StatusFaultBrush}"/></DataTrigger>
            </Style.Triggers>
           </Style>
          </Ellipse.Style>
         </Ellipse>
         <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
          <TextBlock.Style>
           <Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="family"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style>
          </TextBlock.Style>
         </TextBlock>
        </StackPanel>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
     <TextBlock x:Name="NoFamiliesState" Text="{x:Static text:UiText.NoDeviceFamilies}" Visibility="Collapsed" TextWrapping="Wrap"
                Margin="14,8" Foreground="{DynamicResource MutedBrush}"/>
    </Grid>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1">
   <ContentControl x:Name="FamilyContent"/>
   <TextBlock x:Name="UnavailableState" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="520" Margin="20"
    HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
  </Grid>
 </Grid>
</UserControl>
