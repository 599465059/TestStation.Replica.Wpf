<UserControl x:Class="TestStation.App.Views.DeviceInstanceEditorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:text="clr-namespace:TestStation.App.Localization"
 Width="510" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <TextBlock Text="{x:Static text:UiText.Name}" Margin="0,8"/><TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>
  <TextBlock Grid.Row="1" Text="{x:Static text:UiText.HwFamilies}" Margin="0,8"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Families}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedFamily}" IsEnabled="{Binding CanSelectFamily}" Margin="0,3"/>
  <TextBlock Grid.Row="2" Text="{x:Static text:UiText.HwModel}" Margin="0,8"/><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Models}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedModel}" Margin="0,3"/>
  <TextBlock Grid.Row="3" Text="{x:Static text:UiText.CommunicationResource}" Margin="0,8"/>
  <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,3"><Button DockPanel.Dock="Right" Content="{x:Static text:UiText.HwUnbind}" Command="{Binding UnbindCommand}" Margin="6,0,0,0"/><ComboBox ItemsSource="{Binding Resources}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedResource}"/></DockPanel>
  <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{x:Static text:UiText.HwUnboundHint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10"/>
  <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}"/>
 </Grid>
</UserControl>
