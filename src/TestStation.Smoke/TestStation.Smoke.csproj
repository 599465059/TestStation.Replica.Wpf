<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest"/>
    <ProjectReference Include="..\TestStation.Application\TestStation.Application.csproj" />
    <ProjectReference Include="..\TestStation.App\TestStation.App.csproj" />
  </ItemGroup>

  <!-- UI Smoke launches the real Host from its own output directory. -->
  <Target Name="CopySmokeOpenTapHost" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_SmokeOpenTapHostFiles Include="$(MSBuildProjectDirectory)\..\TestStation.OpenTapHost\bin\$(Configuration)\net9.0\**\*" />
    </ItemGroup>
    <Error Condition="'@(_SmokeOpenTapHostFiles)' == ''" Text="UI Smoke requires the built OpenTAP Host." />
    <Copy SourceFiles="@(_SmokeOpenTapHostFiles)"
          DestinationFiles="@(_SmokeOpenTapHostFiles->'$(TargetDir)OpenTapHost\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
